def print_ideas_band(
    slots: list[Slot],
    palette: Palette,
    width: int,
    generated_at: str | None = None,
    selected_id: str | None = None,
    selection_visible: bool = True,
    total: int | None = None,
) -> None:
    # The header counts the band, not the viewport: a clipped pane still says 05.
    print_ideas_header(len(slots) if total is None else total, palette, width, generated_at)
    print()
    if not slots:
        print(f"  {palette.muted('NO IDEAS YET / pulse ideas --refresh writes them')}")
        print()
        return
    for slot in slots:
        if slot.item.id == selected_id:
            print_selected_recommendation(slot, palette, width, selection_visible)
        else:
            print_runway_recommendation(slot, palette, width)
        print()


def compact_pipeline(pipeline: Pipeline) -> str:
    name = pipeline.name.upper()
    if pipeline.last_run_at is None:
        if pipeline.queued:
            return f"{name} / QUEUED {pipeline.queued} · FIRST RUN PENDING"
        if pipeline.start_command:
            return f"{name} / READY · START / {pipeline.start_command}"
        return f"{name} / STANDBY · FIRST RUN PENDING"
    ran = datetime.fromisoformat(pipeline.last_run_at).strftime("%b %-d %-I:%M %p")
    state = f"QUEUED {pipeline.queued}" if pipeline.queued else "IDLE"
    pieces = [f"{name} / {state}", f"LAST {ran}", f"{pipeline.run_count} RUNS"]
    if pipeline.review_files:
        pieces.append(f"{pipeline.review_files} REVIEW RECORDS")
    return " · ".join(pieces)


def rendered_pipeline_summary(pipeline: Pipeline, palette: Palette, width: int) -> str:
    plain = clip_text(compact_pipeline(pipeline), width)
    prefix_end = plain.find(" / ") + 3
    status_end = plain.find(" · ", prefix_end)
    if prefix_end < 3:
        return palette.muted(plain)
    if status_end < 0:
        status_end = len(plain)
    status = plain[prefix_end:status_end]
    paint_status = palette.ready if status in {"READY", "IDLE"} else palette.signal
    return (
        palette.bold(plain[:prefix_end])
        + paint_status(status)
        + palette.muted(plain[status_end:])
    )


def compact_pipeline_token(pipeline: Pipeline, runs: bool = True) -> str:
    if pipeline.queued:
        status = f"QUEUED {pipeline.queued}"
    elif pipeline.last_run_at:
        status = "IDLE"
    elif pipeline.start_command:
        status = "READY"
    else:
        status = "STANDBY"
    detail = f" · {pipeline.run_count} RUNS" if pipeline.run_count and runs else ""
    return f"{pipeline.name.upper()} {status}{detail}"


def rendered_pipeline_token(pipeline: Pipeline, palette: Palette, runs: bool = True) -> str:
    plain = compact_pipeline_token(pipeline, runs)
    name_end = len(pipeline.name)
    detail_at = plain.find(" · ")
    status_end = detail_at if detail_at >= 0 else len(plain)
    status = plain[name_end + 1 : status_end]
    paint_status = palette.ready if status in {"READY", "IDLE"} else palette.signal
    return (
        palette.bold(plain[: name_end + 1])
        + paint_status(status)
        + palette.muted(plain[status_end:])
    )


def print_instrument_footer(
    pipelines: list[Pipeline], palette: Palette, width: int, live: bool
) -> None:
    if pipelines:
        available = width - 3
        if len(pipelines) == 1:
            shown = rendered_pipeline_summary(pipelines[0], palette, available)
        else:
            # A wrapped footer is a frame one row taller than the terminal,
            # which the live pane cannot afford: drop the run counts first,
            # then clip, so the line always stays a line.
            more = f" ◇ +{len(pipelines) - 3} MORE" if len(pipelines) > 3 else ""
            plain = " ◇ ".join(compact_pipeline_token(pipeline) for pipeline in pipelines[:3]) + more
            runs = len(plain) <= available
            if not runs:
                plain = " ◇ ".join(compact_pipeline_token(pipeline, runs=False) for pipeline in pipelines[:3]) + more
            if len(plain) <= available:
                separator = palette.muted(" ◇ ")
                shown = separator.join(
                    rendered_pipeline_token(pipeline, palette, runs) for pipeline in pipelines[:3]
                ) + (palette.muted(more) if more else "")
            else:
                shown = palette.muted(clip_text(plain, available))
    else:
        shown = palette.muted(f"NONE DETECTED / add a workflow under {DEFAULT_WORKFLOWS_DIR}/")
    cadence = "LOCAL 60s / GITHUB 5m" if live else "SNAPSHOT / ON DEMAND"
    line = rule_line("╶─ AGENT PIPELINES / ", f" {cadence} ─╴", width)
    label_end = line.find(" / ") + 3
    print(palette.bold(line[:label_end]) + palette.muted(line[label_end:]))
    print(f"   {shown}")
    if live:
        controls = "↑↓ SELECT  ·  ENTER COPY PROMPT  ·  CTRL-R RESCAN  ·  CTRL-C EXIT"
    else:
        controls = "PULSE PROMPT N / HAND OFF  ·  PULSE DISMISS N / HIDE  ·  --VIBE / FILTER"
