def copy_agent_prompt(item: Recommendation, root: Path) -> bool:
    prompt = io.StringIO()
    with redirect_stdout(prompt):
        print_agent_prompt(item, root)
    try:
        subprocess.run(["pbcopy"], input=prompt.getvalue(), text=True, check=True)
    except (OSError, subprocess.CalledProcessError):
        return False
    return True


