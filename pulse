def selectable_slot_ids(slots: list[Slot]) -> list[str]:
    return [slot.item.id for slot in slots if not slot.resolved]


def move_live_selection(slots: list[Slot], selected_id: str | None, offset: int) -> str | None:
    identities = selectable_slot_ids(slots)
    if not identities:
        return None
    if selected_id not in identities:
        return identities[0]
    return identities[(identities.index(selected_id) + offset) % len(identities)]


def print_live_recommendations(
    slots: list[Slot],
    palette: Palette,
    selected_id: str | None = None,
    selection_visible: bool = True,
    width: int | None = None,
) -> None:
    width = width or dashboard_width()
    if not slots:
        print(f"  {palette.muted('NO ACTIVE SIGNALS / the pane fills as work appears')}")
        print()
        return
    for slot in slots:
        if slot.resolved:
            line = f"    {slot.number:02d}  [{slot.item.category.upper():^10}]  ✓ {slot.item.title}"
            print(palette.muted(clip_text(line, width)))
            print()
            continue
        if slot.item.id == selected_id:
            print_selected_recommendation(slot, palette, width, selection_visible)
        else:
            print_runway_recommendation(slot, palette, width)
        print()


def visible_live_slots(
    slots: list[Slot], selected_id: str | None, capacity: int
) -> list[Slot]:
    """Fit the runway to the viewport while keeping the selection on screen."""
    if capacity >= len(slots):
        return slots
    selected_index = next(
        (index for index, slot in enumerate(slots) if slot.item.id == selected_id),
        0,
    )
    start = max(0, min(selected_index - capacity + 1, len(slots) - capacity))
    return slots[start : start + capacity]


def live_slot_capacity(
    height: int,
    width: int,
    repos: list[Repo],
    github: GithubSnapshot,
    github_fetched_at: datetime | None,
    github_is_fresh: bool,
    has_github_note: bool,
    idea_header_rows: int = 0,
    minimum: int = 1,
) -> int:
    instrument_rows = len(
        pack_segments(
            instrument_segments(repos, github, github_fetched_at, github_is_fresh),
            width - 4,
        )
    )
    # Header, spacing, instrument label, runway label, and footer. The live
    # paint drops the frame's final newline, so no spare row is reserved.
    fixed_rows = 12 + instrument_rows + int(has_github_note) + idea_header_rows
    return max(minimum, (height - fixed_rows) // 4)


def split_live_capacity(capacity: int, runway_count: int, idea_count: int) -> tuple[int, int]:
    """Give the runway what it needs, the band the remainder, but never zero ideas.

    Without this the band pushes the pane past the viewport and the alternate
    screen starts scrolling, which is exactly what it exists to prevent.
    """
    if idea_count == 0 or capacity <= 1:
        return capacity, 0
    ideas = min(idea_count, max(1, capacity - runway_count))
    return max(1, capacity - ideas), ideas


def github_note_shown(github: GithubSnapshot) -> bool:
    return not github.available and bool(github.error) and github.error != "Skipped with --local"


@dataclass
class PaneLayout:
    """Which pieces of the live pane fit the terminal right now."""

    notice: bool = False
    wordmark: bool = True
    instruments: bool = True
    runway_header: bool = True
    runway_capacity: int = 0
    idea_capacity: int = 0
    ideas_stamp: bool = False  # the two-row "TERMINAL TOO SHORT" header
    ideas_empty_band: bool = False  # the "NO IDEAS YET" band, when the runway left room
    footer: bool = True


def pane_layout(
    repos: list[Repo],
    github: GithubSnapshot,
    github_fetched_at: datetime | None,
    github_is_fresh: bool,
    runway_count: int,
    idea_count: int,
) -> PaneLayout:
    """Pick the tallest layout that fits, in a fixed fold order.

    Tall panes get everything. When one move no longer fits, the move folds
    and the runway keeps only its count. Anything smaller is not a dashboard
    any more: the pane shows the notice. Every layout here is exact, because a
    frame that scrolls inside the alternate screen is exactly what the pane
    exists to prevent.
    """
    if viewport_below_floor():
        return PaneLayout(notice=True, wordmark=False, instruments=False, runway_header=False, footer=False)
    height, width = dashboard_height(), dashboard_width()
    has_note = github_note_shown(github)
    capacity = live_slot_capacity(
        height,
        width,
        repos,
        github,
        github_fetched_at,
        github_is_fresh,
        has_note,
        idea_header_rows=2 if idea_count else 0,
        minimum=0,
    )
    if capacity >= 1:
        runway, ideas = split_live_capacity(capacity, runway_count, idea_count)
        return PaneLayout(
            runway_capacity=runway,
            idea_capacity=ideas,
            ideas_stamp=bool(idea_count) and ideas == 0,
            ideas_empty_band=idea_count == 0 and runway > runway_count,
        )
    instrument_rows = len(pack_segments(instrument_segments(repos, github, github_fetched_at, github_is_fresh), width - 4))
    needed = (
        4  # masthead
        + 1 + 1 + instrument_rows + 1  # blank, WORKSPACE line, its segments, blank
        + 2  # runway count and its blank
        + (2 if idea_count else 0)
        + int(has_note)
        + 3  # footer
    )
    if needed > height:
        return PaneLayout(notice=True, wordmark=False, instruments=False, runway_header=False, footer=False)
    return PaneLayout(ideas_stamp=bool(idea_count))


def live_layout(
    repos: list[Repo],
    github: GithubSnapshot,
    github_fetched_at: datetime | None,
    github_is_fresh: bool,
    runway_count: int,
    idea_count: int,
) -> tuple[int, int]:
    """How many runway slots and idea slots fit the terminal right now.

    Shared by the painter and the key loop, so the arrows can only reach an
    idea that is actually on screen.
    """
    capacity = live_slot_capacity(
        dashboard_height(),
        dashboard_width(),
        repos,
        github,
        github_fetched_at,
        github_is_fresh,
        github_note_shown(github),
        idea_header_rows=2 if idea_count else 0,
        minimum=0,  # a move that does not fit is folded, never forced
    )
    return split_live_capacity(capacity, runway_count, idea_count)


def print_live_dashboard(
    root: Path,
    repos: list[Repo],
    pipelines: list[Pipeline],
    github: GithubSnapshot,
    slots: list[Slot],
    palette: Palette,
    github_fetched_at: datetime | None,
    github_is_fresh: bool,
    selected_id: str | None = None,
    selection_visible: bool = True,
    idea_slots: list[Slot] | None = None,
    ideas_generated_at: str | None = None,
) -> None:
    """Paint the live pane in the layout that fits the terminal right now."""
    now = datetime.now().astimezone()
    idea_slots = idea_slots or []
    layout = pane_layout(repos, github, github_fetched_at, github_is_fresh, len(slots), len(idea_slots))
    if layout.notice:
        print_floor_notice(palette)
        return
    width = dashboard_width()
    shown_slots = visible_live_slots(slots, selected_id, layout.runway_capacity)
    shown_ideas = visible_live_slots(idea_slots, selected_id, layout.idea_capacity)
    above = io.StringIO()
    with redirect_stdout(above):
        if layout.wordmark:
            print_masthead(palette, width, now, live=True)
            print()
        if layout.instruments:
            print_instrument_band(
                root,
                repos,
                github,
                palette,
                width,
                github_fetched_at,
                github_is_fresh,
            )
            print()
    print(above.getvalue(), end="")
    if layout.runway_header:
        print_runway_header(
            len(slots), palette, width, stamp="TERMINAL TOO SHORT" if slots and not layout.runway_capacity else None
        )
        if layout.runway_capacity or layout.idea_capacity or layout.ideas_stamp or layout.ideas_empty_band or layout.footer:
            print()  # the header's spacing belongs to what follows it; alone, it ends the frame
        if layout.runway_capacity:
            print_live_recommendations(shown_slots, palette, selected_id, selection_visible, width)
    if idea_slots and layout.idea_capacity:
        print_ideas_band(
            shown_ideas, palette, width, ideas_generated_at, selected_id, selection_visible, len(idea_slots)
        )
    elif layout.ideas_stamp:
        # The two reserved rows say the band exists rather than pretending it is
        # empty; a taller terminal brings it back without a restart.
        print_ideas_header(len(idea_slots), palette, width, ideas_generated_at, stamp="TERMINAL TOO SHORT")
        print()
    elif layout.ideas_empty_band:
        # An empty band costs one slot's worth of rows; spend them only when
        # the runway left them over, so a first-time viewer learns the band
        # exists and how to fill it.
        print_ideas_band([], palette, width, ideas_generated_at)
    if layout.instruments and github_note_shown(github):
        print(f"  {palette.muted('GITHUB NOTE / ' + clip_text(github.error, width - 18))}")
    if layout.footer:
        print_instrument_footer(pipelines, palette, width, live=True)


def wants_live_pane(args: argparse.Namespace) -> bool:
    """Bare `pulse` on a TTY stays live; pipes, --json, and --once stay one-shot."""
    return args.command == "today" and not args.once and not args.json and sys.stdout.isatty()


@contextmanager
def live_input() -> Iterable[int | None]:
    """Yield a cbreak stdin descriptor, restoring the terminal on every exit."""
    if not sys.stdin.isatty():
        yield None
        return
    descriptor = sys.stdin.fileno()
    settings = termios.tcgetattr(descriptor)
    tty.setcbreak(descriptor)
    try:
        yield descriptor
    finally:
        termios.tcsetattr(descriptor, termios.TCSADRAIN, settings)


def read_live_key(descriptor: int, timeout: float) -> str | None:
    ready, _writable, _errors = select.select([descriptor], [], [], max(0.0, timeout))
    if not ready:
        return None
    pressed = os.read(descriptor, 1)
    if pressed == b"\x1b":
        while select.select([descriptor], [], [], 0.01)[0]:
            pressed += os.read(descriptor, 1)
    if pressed in {b"\x1b[A", b"\x1bOA"}:
        return "up"
    if pressed in {b"\x1b[B", b"\x1bOB"}:
        return "down"
    if pressed in {b"\r", b"\n"}:
        return "enter"
    if pressed == b"\x12":
        return "refresh"
    return "other"


def run_live(args: argparse.Namespace, root: Path, state_path: Path, palette: Palette) -> int:
    """Paint an interactive dashboard: Git every minute, GitHub every five."""
    session = LiveSession(args.vibe, args.limit)
    github: GithubSnapshot | None = None
    github_at: datetime | None = None
    selected_id: str | None = None
    force_github = False
    # The alternate screen isolates the dashboard from shell scrollback and
    # restores the exact previous terminal contents when the pane exits.
    sys.stdout.write(ALT_SCREEN_ENTER + CURSOR_HIDE)
    try:
        with live_input() as input_descriptor:
            while True:
                tick_started = time.monotonic()
                now = datetime.now(timezone.utc)
                repos = inspect_workspace(root)
                pipelines = inspect_pipelines(root)
                github_is_fresh = github is None or (
                    not args.local
                    and (force_github or (now - github_at).total_seconds() >= GITHUB_REFRESH_SECONDS)
                )
                force_github = False
                if github_is_fresh:
                    github = fetch_github(args.local)
                    github_at = now

                dismissals = load_dismissals(state_path)
                visible = visible_recommendations(all_recommendations(root, repos, github), dismissals)
                hidden = frozenset(entry["id"] for entry in dismissals)
                slots = session.refresh(visible, now, hidden)
                stored_ideas = load_ideas(state_path)
                idea_slots = session.refresh_ideas(visible_ideas(stored_ideas, dismissals, args.type))
                # One number space across both bands, so prompt/dismiss/did all
                # resolve against the same list the user is reading.
                listed = slots + idea_slots
                navigable = listed
                save_listing(
                    state_path,
                    args.vibe,
                    [(slot.number, slot.item) for slot in listed],
                    live_pid=os.getpid(),
                )

                def paint(selection_visible: bool = True) -> None:
                    nonlocal navigable, selected_id
                    # A band the terminal cannot show is not one the arrows can
                    # reach; its numbers still resolve from another shell.
                    runway_capacity, idea_capacity = 0, 0
                    if slots or idea_slots:
                        layout = pane_layout(repos, github, github_at, github_is_fresh, len(slots), len(idea_slots))
                        runway_capacity, idea_capacity = layout.runway_capacity, layout.idea_capacity
                    navigable = (slots if runway_capacity else []) + (idea_slots if idea_capacity else [])
                    if navigable:
                        selected_id = move_live_selection(navigable, selected_id, 0)
                    screen = io.StringIO()
                    with redirect_stdout(screen):
                        print_live_dashboard(
                            root,
                            repos,
                            pipelines,
                            github,
                            slots,
                            palette,
                            github_at,
                            github_is_fresh,
                            selected_id,
                            selection_visible,
                            idea_slots,
                            stored_ideas.get("generated_at"),
                        )
                    # Without the final newline the frame may use every row the
                    # terminal has; with it, a full-height frame scrolls by one.
                    sys.stdout.write("\033[H\033[2J" + screen.getvalue().rstrip("\n"))
                    sys.stdout.flush()

                paint()
                wait = max(1.0, LIVE_REFRESH_SECONDS - (time.monotonic() - tick_started))
                refresh_at = time.monotonic() + wait
                terminal_size = shutil.get_terminal_size(fallback=(104, 36))
                while True:
                    remaining = refresh_at - time.monotonic()
                    if input_descriptor is None:
                        time.sleep(max(0.0, remaining))
                        key = None
                    else:
                        key = read_live_key(
                            input_descriptor,
                            min(LIVE_RESIZE_POLL_SECONDS, max(0.0, remaining)),
                        )
                    if key is None:
                        if time.monotonic() >= refresh_at:
                            break
                        if input_descriptor is not None:
                            resized = shutil.get_terminal_size(fallback=(104, 36))
                            if resized != terminal_size:
                                terminal_size = resized
                                paint()
                        continue
                    if key == "up" and navigable:
                        selected_id = move_live_selection(navigable, selected_id, -1)
                        paint()
                    elif key == "down" and navigable:
                        selected_id = move_live_selection(navigable, selected_id, 1)
                        paint()
                    elif key == "enter" and selected_id is not None:
                        selected = next(
                            (
                                slot.item
                                for slot in navigable
                                if slot.item.id == selected_id and not slot.resolved
                            ),
                            None,
                        )
                        if selected is not None and copy_agent_prompt(selected, root):
                            paint(selection_visible=False)
                            time.sleep(COPY_BLINK_SECONDS)
                            paint()
                    elif key == "refresh":
                        force_github = True
                        break
    except KeyboardInterrupt:
        return 0
    finally:
        clear_live_marker(state_path)
        sys.stdout.write(CURSOR_SHOW + ALT_SCREEN_LEAVE)
        sys.stdout.flush()


AGENTS_MIN_WIDTH = AGENT_GRID_MIN_COLUMNS * AGENT_STRIP_MIN_WIDTH  # 20: two ten-cell cards
AGENTS_MASTHEAD_ROWS = 5  # title line, the three-row wordmark, and a blank line
AGENTS_MIN_HEIGHT = AGENT_BAND_ACTIVE_ROWS  # 8: header and one complete card row


def agent_grid_rows(lines: int, columns: int, sessions: int) -> tuple[int, bool]:
    """Choose full rows first; the masthead yields when it would cost a row."""
    without_masthead = (lines - 1) // AGENT_STRIP_ROWS
    with_masthead = (lines - AGENTS_MASTHEAD_ROWS - 1) // AGENT_STRIP_ROWS
    needed_rows = max(1, (sessions + columns - 1) // columns)
    use_masthead = with_masthead >= 1 and (
        needed_rows <= with_masthead or with_masthead == without_masthead
    )
    return (with_masthead if use_masthead else without_masthead), use_masthead


def agents_frame_rows(
    band: AgentBand,
    palette: Palette,
    columns: int,
    lines: int,
    frame: int,
    now: datetime,
    live: bool = True,
) -> list[str]:
    """A two-to-six-column full-card grid, packed into the real terminal."""
    if columns < AGENTS_MIN_WIDTH or lines < AGENTS_MIN_HEIGHT:
        notice = f"MAKE THE WINDOW {AGENTS_MIN_WIDTH}x{AGENTS_MIN_HEIGHT} OR LARGER"
        return [palette.muted(clip_text(notice, max(1, columns)))]
    width = min(columns, DASHBOARD_MAX_WIDTH)
    grid_columns = agent_grid_columns(width)
    framed = width >= 70
    if not band.active:
        return agent_band_rows(band, palette, width, frame, now, grid_columns, 1, framed)
    session_count = len(agent_band_strips(band))
    grid_rows, use_masthead = agent_grid_rows(lines, grid_columns, session_count)
    local = now.astimezone()
    if use_masthead:
        masthead = io.StringIO()
        with redirect_stdout(masthead):
            print_masthead(palette, width, local, live=live, label="AGENTS")
            print()
        return masthead.getvalue().split("\n")[:-1] + agent_band_rows(
            band, palette, width, frame, now, grid_columns, grid_rows, framed
        )
    return agent_band_rows(band, palette, width, frame, now, grid_columns, grid_rows, framed)


def run_agents(args: argparse.Namespace, root: Path, palette: Palette) -> int:
    """`pulse agents`: the live agent band on its own, once a second, and nothing else.

    A strip parked in a corner should cost nothing and claim nothing: no
    repository or GitHub scan, no numbering ownership, no keys beyond Ctrl-C.
    Every tick rewrites the band's rows in place; only a resize or a change
    in the band's height clears the screen.
    """
    collector = AgentCollector(root=root)
    band = AgentBand()
    now = datetime.now(timezone.utc)
    band.update(collector.scan(now), now)
    if args.once or not sys.stdout.isatty():
        size = shutil.get_terminal_size(fallback=(104, 36))
        for row in agents_frame_rows(band, palette, size.columns, size.lines, 0, now, live=False):
            print(row)
        return 0
    frame = 0
    painted: tuple[os.terminal_size, int] | None = None
    sys.stdout.write(ALT_SCREEN_ENTER + CURSOR_HIDE)
    try:
        with live_input() as input_descriptor:
            while True:
                now = datetime.now(timezone.utc)
                band.update(collector.scan(now), now)
                size = shutil.get_terminal_size(fallback=(104, 36))
                rows = agents_frame_rows(band, palette, size.columns, size.lines, frame, now)
                geometry = (size, len(rows))
                if geometry != painted:
                    sys.stdout.write("\033[H\033[2J" + "\n".join(rows))
                else:
                    sys.stdout.write("".join(f"\033[{index};1H\033[2K{row}" for index, row in enumerate(rows, 1)))
                sys.stdout.flush()
                painted = geometry
                frame += 1
                deadline = time.monotonic() + AGENT_TICK_SECONDS
                while True:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        break
                    if input_descriptor is None:
                        time.sleep(remaining)
                    else:
                        # Keys mean nothing here; reading them keeps the terminal
                        # from echoing them over the band. Ctrl-C still interrupts.
                        read_live_key(input_descriptor, min(LIVE_RESIZE_POLL_SECONDS, remaining))
    except KeyboardInterrupt:
        return 0
    finally:
        sys.stdout.write(CURSOR_SHOW + ALT_SCREEN_LEAVE)
        sys.stdout.flush()


def print_doctor(root: Path, repos: list[Repo], github: GithubSnapshot, palette: Palette) -> None:
    print(palette.bold("PROJECT PULSE DOCTOR"))
    print()
    checks = [
        ("Workspace", root.exists(), str(root)),
        ("Git", shutil.which("git") is not None, shutil.which("git") or "not found"),
        ("GitHub CLI", shutil.which("gh") is not None, shutil.which("gh") or "not found"),
        ("GitHub auth", github.available, f"@{github.user}" if github.available else github.error or "unavailable"),
        ("Repository scan", bool(repos), f"{len(repos)} active repositories"),
    ]
    for name, okay, detail in checks:
        mark = palette.paint("32" if okay else "33", "✓" if okay else "!")
        print(f"  {mark} {name:<16} {detail}")


def json_payload(
    root: Path,
    repos: list[Repo],
    pipelines: list[Pipeline],
    github: GithubSnapshot,
    items: list[Recommendation],
    ideas: list[Recommendation] | None = None,
) -> str:
    payload = {
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "root": str(root),
        "repositories": [{**asdict(repo), "changed": repo.changed, "clean": repo.clean} for repo in repos],
        "pipelines": [asdict(pipeline) for pipeline in pipelines],
        "github": asdict(github),
        "recommendations": [{**asdict(item), "id": item.id} for item in items],
        "ideas": [{**asdict(item), "id": item.id} for item in ideas or []],
    }
    return json.dumps(payload, indent=2)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="pulse",
        description="Turn local repository and GitHub state into useful next moves.",
    )
    parser.add_argument(
        "command",
        nargs="?",
        default="today",
        choices=(
            "today",
            "next",
            "repos",
            "pipelines",
            "doctor",
            "prompt",
            "dismiss",
            "dismissed",
            "restore",
            "ideas",
            "did",
            "agents",
        ),
    )
    parser.add_argument("item", nargs="?", type=int, help="Number shown by prompt, dismiss, did, or restore")
    parser.add_argument(
        "--root",
        type=Path,
        default=None,
        help="workspace to scan (default: $PROJECTS_ROOT, then config `root`, then ~/Projects)",
    )
    parser.add_argument("--vibe", choices=VIBES, default="anything", help="Only suggest this kind of work")
    parser.add_argument("--limit", type=int, default=5, help="Number of next moves to show")
    parser.add_argument("--local", action="store_true", help="Skip GitHub and use local repository state only")
    parser.add_argument("--once", action="store_true", help="Print one frame and exit (the live pane is the TTY default)")
    parser.add_argument("--json", action="store_true", help="Emit machine-readable JSON")
    parser.add_argument("--no-color", action="store_true", help="Disable ANSI colors")
    parser.add_argument("--type", choices=IDEA_KINDS, help="Only show ideas of this kind")
    parser.add_argument("--ideas", type=int, default=IDEA_LIMIT, help="How many ideas the band holds")
    parser.add_argument(
        "--refresh", action="store_true", help="ideas: write a new set with the model (costs tokens)"
    )
    parser.add_argument("--pack", action="store_true", help="ideas: print the context pack and exit")
    parser.add_argument("--set", metavar="FILE", help="ideas: read ideas from FILE, or - for stdin")
    return parser


def act_on_item(
    args: argparse.Namespace, root: Path, state_path: Path, dismissals: list[dict[str, Any]]
) -> int:
    """Resolve a number against the list the user was last shown, not a fresh one.

    Re-deriving the list here made the number mean whatever now sits in that slot:
    a push, a deleted recipe, or the previous handoff agent's own work silently
    renumbered everything between reading the dashboard and acting on it.
    """
    listing, shown_at = load_listing(state_path)
    if not listing:
        print("pulse: no recent list to number against; run pulse first", file=sys.stderr)
        return 2
    item = next((entry for number, entry in listing if number == args.item), None)
    if item is None:
        numbers = ", ".join(str(number) for number, _ in listing)
        print(
            f"pulse: item {args.item} is not in the list you were shown (numbers: {numbers})",
            file=sys.stderr,
        )
        return 2

    if args.command == "dismiss":
        dismiss_item(state_path, dismissals, item)
        print(f"Dismissed: {item.title}")
        print("Restore it later with: pulse dismissed")
        return 0

    if args.command == "did":
        if item.source != "idea":
            print(
                f"pulse: {args.item} is a state-based move, not an idea — it clears when its "
                "condition does, or hide it with: pulse dismiss",
                file=sys.stderr,
            )
            return 2
        mark_idea_done(state_path, load_ideas(state_path), item)
        print(f"Retired: {item.title}")
        print("The next `pulse ideas --refresh` fills the slot it left.")
        return 0

    if item.source == "idea":
        # Nothing in a fresh scan can confirm or deny an idea, so there is no
        # freshness check to run against one.
        print_agent_prompt(item, root)
        return 0

    repos = inspect_workspace(root)
    github = fetch_github(args.local)
    still_live = {found.id for found in all_recommendations(root, repos, github)}
    print_agent_prompt(item, root)
    if item.id not in still_live:
        when = f" (list shown {shown_at})" if shown_at else ""
        print(
            f"pulse: heads up — this recommendation no longer appears in a fresh scan{when}; "
            "it may already be resolved",
            file=sys.stderr,
        )
    return 0


def act_on_ideas(
    args: argparse.Namespace,
    root: Path,
    state_path: Path,
    dismissals: list[dict[str, Any]],
    palette: Palette,
) -> int:
    """Print the band, or rewrite it — on request only, never on a timer."""
    model = os.environ.get("PULSE_IDEAS_MODEL", IDEA_MODEL)
    stored = load_ideas(state_path)

    writing = args.refresh or args.pack or args.set is not None
    need = free_idea_slots(stored, dismissals, args.ideas)
    if writing and need == 0:
        # Nothing to fill: a refresh here would spend tokens, store nothing, and
        # restamp the band as freshly written.
        print(f"pulse: {band_full_reason(args.ideas)}", file=sys.stderr)
        return 1

    if args.pack:
        print(json.dumps(build_idea_pack(root, inspect_workspace(root), stored, dismissals, need), indent=2))
        return 0

    if args.set:
        try:
            raw = sys.stdin.read() if args.set == "-" else Path(args.set).read_text(encoding="utf-8")
            incoming = parse_ideas(extract_json(raw))
        except (OSError, UnicodeDecodeError, IdeaError) as error:
            print(f"pulse: {error}", file=sys.stderr)
            print("pulse: existing ideas are unchanged", file=sys.stderr)
            return 1
        stored = store_ideas(state_path, stored, dismissals, incoming, args.ideas, "hand-written")
    elif args.refresh:
        try:
            stored = refresh_ideas(
                state_path, root, inspect_workspace(root), dismissals, model, args.ideas
            )
        except IdeaError as error:
            print(f"pulse: idea refresh failed: {error}", file=sys.stderr)
            print("pulse: existing ideas are unchanged", file=sys.stderr)
            return 1

    ideas = visible_ideas(stored, dismissals, args.type)
    if args.json:
        print(
            json.dumps(
                {
                    "generated_at": stored.get("generated_at"),
                    "model": stored.get("model"),
                    "ideas": [{**asdict(item), "id": item.id} for item in ideas],
                },
                indent=2,
            )
        )
        return 0

    print_ideas_band(
        [Slot(number, item) for number, item in enumerate(ideas, 1)],
        palette,
        dashboard_width(),
        stored.get("generated_at"),
    )
    if live_pane_owns_numbering(state_path):
        print(palette.dim("  A live pane is open; prompt/dismiss/did numbers still follow that pane."))
    elif ideas:
        # An empty band numbers nothing, so it must not erase the numbering the
        # user is still reading off the last dashboard.
        save_listing(state_path, args.vibe, list(enumerate(ideas, 1)))
    return 0


def resolve_root(explicit: Path | None, config: dict[str, Any]) -> Path:
    """--root beats $PROJECTS_ROOT beats the config file beats ~/Projects."""
    if explicit is not None:
        return explicit.expanduser().resolve()
    environment = os.environ.get("PROJECTS_ROOT")
    if environment:
        return Path(environment).expanduser().resolve()
    configured = configured_root(config)
    if configured is not None:
        return configured.resolve()
    return (Path.home() / "Projects").resolve()


def main(argv: Iterable[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    config = load_config()
    root = resolve_root(args.root, config)
    if not root.is_dir():
        print(f"pulse: workspace does not exist: {root}", file=sys.stderr)
        return 2
    if args.limit < 1:
        print("pulse: --limit must be at least 1", file=sys.stderr)
        return 2

    if args.ideas < 1:
        print("pulse: --ideas must be at least 1", file=sys.stderr)
        return 2
    idea_flags = args.refresh or args.pack or args.set is not None
    if idea_flags and args.command != "ideas":
        print("pulse: --refresh, --pack, and --set only apply to: pulse ideas", file=sys.stderr)
        return 2
    if args.refresh and args.set is not None:
        print("pulse: choose either --refresh or --set, not both", file=sys.stderr)
        return 2

    numbered_commands = {"prompt", "dismiss", "did", "restore"}
    if args.command in numbered_commands and args.item is None:
        print(f"pulse: {args.command} needs the number of an item", file=sys.stderr)
        return 2
    if args.command not in numbered_commands and args.item is not None:
        print(f"pulse: {args.command} does not accept an item number", file=sys.stderr)
        return 2
    if args.item is not None and args.item < 1:
        print("pulse: item number must be at least 1", file=sys.stderr)
        return 2

    colors = sys.stdout.isatty() and not args.no_color and "NO_COLOR" not in os.environ
    palette = Palette(colors)
    state_path = default_state_path()
    dismissals = load_dismissals(state_path)

    if args.command == "dismissed":
        if args.json:
            print(json.dumps({"state_path": str(state_path), "dismissed": dismissals}, indent=2))
        else:
            print_dismissed(dismissals, palette)
        return 0
    if args.command == "restore":
        assert args.item is not None
        if args.item > len(dismissals):
            print(f"pulse: dismissed item {args.item} does not exist", file=sys.stderr)
            return 2
        restored = dismissals[args.item - 1]
        save_dismissals(state_path, dismissals[: args.item - 1] + dismissals[args.item :])
        print(f"Restored: {restored.get('title', restored['id'])}")
        print("It can appear again whenever its underlying condition still exists.")
        return 0

    if args.command == "ideas":
        return act_on_ideas(args, root, state_path, dismissals, palette)

    if args.command == "agents":
        return run_agents(args, root, palette)

    if args.command in {"prompt", "dismiss", "did"}:
        assert args.item is not None
        return act_on_item(args, root, state_path, dismissals)

    if wants_live_pane(args):
        return run_live(args, root, state_path, palette)

    repos = inspect_workspace(root)
    pipelines = inspect_pipelines(root)
    github = fetch_github(args.local or args.command in {"repos", "pipelines"})
    recommendations = all_recommendations(root, repos, github)
    visible = visible_recommendations(recommendations, dismissals)
    selected = select_recommendations(visible, args.vibe, 1 if args.command == "next" else args.limit)
    stored_ideas = load_ideas(state_path)
    # `next` is the single-move command: one thing to do now, not a reading list.
    band = [] if args.command == "next" else visible_ideas(stored_ideas, dismissals, args.type)
    pane_owns_numbers = False
    if args.command in {"today", "next"} or args.json:
        pane_owns_numbers = live_pane_owns_numbering(state_path)
        if not pane_owns_numbers:
            entries = list(enumerate(selected, 1))
            entries += list(enumerate(band, len(selected) + 1))
            save_listing(state_path, args.vibe, entries)

    if args.json:
        print(json_payload(root, repos, pipelines, github, selected, band))
        return 0

    if args.command == "repos":
        print_repos(repos, palette)
    elif args.command == "pipelines":
        print_pipelines(pipelines, palette)
    elif args.command == "doctor":
        print_doctor(root, repos, github, palette)
    elif args.command == "next":
        print_recommendations(selected, palette)
    else:
        print_dashboard(
            root,
            repos,
            pipelines,
            github,
            selected,
            palette,
            band,
            stored_ideas.get("generated_at"),
        )
    if pane_owns_numbers:
        print()
        print(palette.dim("  A live pane is open; prompt/dismiss/did numbers still follow that pane."))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
