def default_state_path() -> Path:
    override = os.environ.get("PULSE_STATE_PATH")
    if override:
        return Path(override).expanduser()
    state_home = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))
    return state_home / "project-pulse" / "state.json"


def read_state(path: Path) -> dict[str, Any]:
    try:
        payload = json.loads(path.read_text())
    except (OSError, ValueError, TypeError):
        return {}
    return payload if isinstance(payload, dict) else {}


def write_state(path: Path, state: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps({**state, "version": 1}, indent=2) + "\n")
    temporary.replace(path)


def load_dismissals(path: Path) -> list[dict[str, Any]]:
    dismissals = read_state(path).get("dismissed", [])
    if not isinstance(dismissals, list):
        return []
    return [item for item in dismissals if isinstance(item, dict) and isinstance(item.get("id"), str)]


def save_dismissals(path: Path, dismissals: list[dict[str, Any]]) -> None:
    write_state(path, {**read_state(path), "dismissed": dismissals})


LISTING_FIELDS = ("score", "category", "title", "detail", "command", "repo", "source")
# Read with .get() so a state file written before the ideas band still parses.
# A strict read would reject the whole listing and silently reset the numbering
# a user is reading off an open pane.
LISTING_OPTIONAL_FIELDS = ("prompt",)


def save_listing(
    path: Path, vibe: str, entries: list[tuple[int, Recommendation]], live_pid: int | None = None
) -> None:
    """Remember the list just shown, so `prompt N` means the N the user read.

    Entries carry their displayed numbers explicitly: the live pane never reuses
    a number within a session, so its list is sparse once items resolve.
    """
    listing = {
        "shown_at": datetime.now(timezone.utc).isoformat(),
        "vibe": vibe,
        "items": [
            {
                "number": number,
                **{field: getattr(item, field) for field in LISTING_FIELDS + LISTING_OPTIONAL_FIELDS},
            }
            for number, item in entries
        ],
    }
    state = {**read_state(path), "listing": listing}
    if live_pid is not None:
        state["live"] = {"pid": live_pid, "updated_at": datetime.now(timezone.utc).isoformat()}
    try:
        write_state(path, state)
    except OSError:
        pass  # A dashboard that cannot cache its numbering is still a useful dashboard.


def load_listing(path: Path) -> tuple[list[tuple[int, Recommendation]], str | None]:
    listing = read_state(path).get("listing")
    if not isinstance(listing, dict) or not isinstance(listing.get("items"), list):
        return [], None
    entries: list[tuple[int, Recommendation]] = []
    for index, entry in enumerate(listing["items"], 1):
        if not isinstance(entry, dict):
            return [], None
        try:
            values = {field: entry[field] for field in LISTING_FIELDS}
            values.update({field: entry.get(field) for field in LISTING_OPTIONAL_FIELDS})
            item = Recommendation(**values)
        except (KeyError, TypeError):
            return [], None
        number = entry.get("number", index)  # pre-live state files had implicit 1..N numbering
        if not isinstance(number, int):
            return [], None
        entries.append((number, item))
    shown_at = listing.get("shown_at")
    return entries, shown_at if isinstance(shown_at, str) else None


def clear_live_marker(path: Path) -> None:
    state = read_state(path)
    if "live" in state:
        try:
            write_state(path, {key: value for key, value in state.items() if key != "live"})
        except OSError:
            pass


def process_is_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:
        return True  # e.g. PermissionError: it exists, it just is not ours
    return True


def live_pane_owns_numbering(path: Path) -> bool:
    """True while another process's live pane is the list the user is reading.

    A one-shot run must not overwrite that pane's numbering: the pane is what
    the user reads numbers off, so `prompt 3` has to keep meaning the pane's 3.
    """
    live = read_state(path).get("live")
    if not isinstance(live, dict):
        return False
    pid = live.get("pid")
    if not isinstance(pid, int) or pid == os.getpid():
        return False
    try:
        stamped = datetime.fromisoformat(live.get("updated_at"))
    except (TypeError, ValueError):
        return False
    age = (datetime.now(timezone.utc) - stamped).total_seconds()
    return age < LIVE_MARKER_TTL_SECONDS and process_is_alive(pid)


def dismiss_item(path: Path, dismissals: list[dict[str, Any]], item: Recommendation) -> list[dict[str, Any]]:
    if any(entry["id"] == item.id for entry in dismissals):
        return dismissals
    updated = [
        *dismissals,
        {
            "id": item.id,
            "title": item.title,
            "category": item.category,
            "repo": item.repo,
            "dismissed_at": datetime.now(timezone.utc).isoformat(),
        },
    ]
    save_dismissals(path, updated)
    return updated


def visible_recommendations(
    recommendations: list[Recommendation], dismissals: list[dict[str, Any]]
) -> list[Recommendation]:
    hidden = {item["id"] for item in dismissals}
    return [item for item in recommendations if item.id not in hidden]


def run(
    command: list[str], cwd: Path | None = None, timeout: int = 8, stdin: str | None = None
) -> subprocess.CompletedProcess[str]:
    env = os.environ.copy()
    env.update({"GH_PAGER": "cat", "PAGER": "cat", "CLICOLOR": "0"})
    try:
        return subprocess.run(
            command,
            cwd=cwd,
            env=env,
            text=True,
            input=stdin,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(command, 124, "", str(exc))


def git(repo: Path, *args: str) -> str | None:
    result = run(["git", *args], cwd=repo)
    return result.stdout.strip() if result.returncode == 0 else None


def relative_name(root: Path, repo: Path) -> str:
    relative = repo.relative_to(root)
    return repo.name if str(relative) == "." else str(relative)


def discover_repositories(root: Path) -> list[Path]:
    repositories: list[Path] = []
    for current, directories, _files in os.walk(root):
        directories[:] = [
            name
            for name in directories
            if name not in SKIP_DIRECTORIES and not (name.startswith(".") and name != ".git")
        ]
        path = Path(current)
        if ".git" in directories or (path / ".git").is_file():
            repositories.append(path)
            # The workspace root being a repo (the meta-repo) must not stop the
            # scan: the product repos live inside it. Nested repos stay opaque.
            if path != root:
                directories[:] = []
    return sorted(repositories, key=lambda path: str(path).lower())


def infer_technology(path: Path) -> str:
    if (path / "Package.swift").exists() or list(path.glob("*.xcodeproj")):
        return "swift"
    if (path / "package.json").exists():
        return "node"
    if (path / "pyproject.toml").exists() or (path / "requirements.txt").exists():
        return "python"
    if (path / "Cargo.toml").exists():
        return "rust"
    if (path / "go.mod").exists():
        return "go"
    return "repo"


def detects_tests(path: Path, technology: str) -> bool:
    if (path / "tests").is_dir() or (path / "Tests").is_dir():
        return True
    if technology == "node":
        try:
            package = json.loads((path / "package.json").read_text())
            scripts = package.get("scripts", {})
            return any(name in scripts for name in ("test", "check", "lint", "typecheck"))
        except (OSError, ValueError, TypeError):
            return False
    if technology == "swift":
        return bool(list(path.glob("*Tests"))) or (path / "Tests").exists()
    makefile = path / "Makefile"
    if makefile.exists():
        try:
            return "test:" in makefile.read_text(errors="ignore")
        except OSError:
            pass
    return False


def declares_local_only(path: Path) -> bool:
    """True when the repo has declared, in its own config, that it stays off GitHub.

    Without a durable declaration the "no origin remote" card is unanswerable: a
    deliberate local-only repo looks identical to one nobody got around to
    publishing, so the card returns every scan. `git config --bool pulse.localOnly
    true` records the decision where the repo itself keeps it.
    """
    value = git(path, "config", "--bool", "--get", "pulse.localOnly")
    return value == "true"


def inspect_repo(root: Path, path: Path, now: datetime) -> Repo:
    status = git(path, "status", "--porcelain=v2", "--branch", "--untracked-files=normal") or ""
    repo = Repo(name=relative_name(root, path), path=str(path))
    for line in status.splitlines():
        if line.startswith("# branch.head "):
            repo.branch = line.removeprefix("# branch.head ")
        elif line.startswith("# branch.upstream "):
            repo.upstream = line.removeprefix("# branch.upstream ")
        elif line.startswith("# branch.ab "):
            pieces = line.split()
            repo.ahead = int(pieces[2].lstrip("+"))
            repo.behind = abs(int(pieces[3]))
        elif line.startswith("? "):
            repo.untracked += 1
        elif line.startswith("u "):
            repo.conflicted += 1
        elif line.startswith(("1 ", "2 ")):
            state = line.split(maxsplit=2)[1]
            if state[0] != ".":
                repo.staged += 1
            if state[1] != ".":
                repo.unstaged += 1

    repo.remote = git(path, "remote", "get-url", "origin")
    repo.local_only = declares_local_only(path)
    epoch = git(path, "log", "-1", "--format=%ct")
    if epoch and epoch.isdigit():
        committed = datetime.fromtimestamp(int(epoch), tz=timezone.utc)
        repo.last_commit_at = committed.isoformat()
        repo.age_days = max(0, (now - committed).days)

    repo.has_readme = any((path / name).exists() for name in ("README.md", "README", "README.rst"))
    workflow_dir = path / ".github" / "workflows"
    repo.has_workflow = workflow_dir.is_dir() and any(
        item.suffix in {".yml", ".yaml"} for item in workflow_dir.iterdir() if item.is_file()
    )
    repo.technology = infer_technology(path)
    repo.has_tests = detects_tests(path, repo.technology)
    return repo


def inspect_workspace(root: Path) -> list[Repo]:
    now = datetime.now(timezone.utc)
    return [inspect_repo(root, path, now) for path in discover_repositories(root)]


# ---------------------------------------------------------------------------
# Configuration
#
# Pulse ships knowing nothing about your workspace beyond "it is a directory of
# repositories". Anything site-specific — where the root is, what the workflows
# directory is called, and any pipeline that lives outside it — comes from a
# TOML file. See pulse.toml.example. A missing or malformed file is not an
# error: pulse falls back to its defaults and `pulse doctor` reports why.
# ---------------------------------------------------------------------------

CONFIG_ENV = "PULSE_CONFIG"
DEFAULT_WORKFLOWS_DIR = "AgentWorkflows"


def config_path() -> Path:
    override = os.environ.get(CONFIG_ENV)
    if override:
        return Path(override).expanduser()
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return config_home / "project-pulse" / "pulse.toml"


def load_config(path: Path | None = None) -> dict[str, Any]:
    """Read the TOML config. Any failure yields {} so pulse still runs."""
    target = path or config_path()
    try:
        with target.open("rb") as handle:
            loaded = tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError):
        return {}
    return loaded if isinstance(loaded, dict) else {}


def configured_root(config: dict[str, Any]) -> Path | None:
    root = config.get("root")
    return Path(str(root)).expanduser() if isinstance(root, str) and root else None


def configured_pipelines(root: Path, config: dict[str, Any]) -> list[Pipeline]:
    """Build pipelines declared in [[pipeline]] that live outside the workflows directory.

    Each entry is skipped unless its `detect` path exists, so a config shared
    across machines quietly describes only what is actually installed here.
    """
    entries = config.get("pipeline")
    if not isinstance(entries, list):
        return []
    pipelines: list[Pipeline] = []
    for entry in entries:
        if not isinstance(entry, dict):
            continue
        name = entry.get("name")
        detect = entry.get("detect")
        if not isinstance(name, str) or not name or not isinstance(detect, str) or not detect:
            continue
        marker = Path(detect).expanduser()
        if not marker.is_absolute():
            marker = root / marker
        if not marker.exists():
            continue
        pipeline = Pipeline(name=name)
        start = entry.get("start_command")
        if isinstance(start, str) and start:
            pipeline.start_command = start
        log = entry.get("log")
        if isinstance(log, str) and log:
            log_path = Path(log).expanduser()
            if not log_path.is_absolute():
                log_path = root / log_path
            read_pipeline_log(pipeline, log_path)
        pipelines.append(pipeline)
    return pipelines


def read_pipeline_log(pipeline: Pipeline, log_path: Path) -> None:
    """Count runs in a flat log whose every line begins with an ISO timestamp."""
    try:
        lines = [
            line.strip()
            for line in log_path.read_text(errors="replace").splitlines()
            if line.strip()
        ]
        pipeline.run_count = len(lines)
        if lines:
            stamp = lines[-1].split(maxsplit=1)[0]
            pipeline.last_run_at = datetime.fromisoformat(stamp).astimezone().isoformat()
            pipeline.last_line = lines[-1][:120]
    except (OSError, ValueError):
        pass


def inspect_pipelines(root: Path, config: dict[str, Any] | None = None) -> list[Pipeline]:
    """Summarize the workspace's workflows from their logs and state. Read-only."""
    config = load_config() if config is None else config
    workflows_name = config.get("workflows_dir")
    if not isinstance(workflows_name, str) or not workflows_name:
        workflows_name = DEFAULT_WORKFLOWS_DIR
    workflow_args = config.get("workflow_args")
    if not isinstance(workflow_args, dict):
        workflow_args = {}
    workflows = root / workflows_name
    pipelines: list[Pipeline] = []
    if workflows.is_dir():
        for directory in sorted(workflows.iterdir()):
            if not directory.is_dir() or directory.name.startswith((".", "_")):
                continue
            if not any((directory / marker).exists() for marker in ("logs", "state", "orchestrator.py")):
                continue
            pipeline = Pipeline(name=directory.name)
            launcher = directory / directory.name
            if launcher.is_file():
                relative_launcher = launcher.relative_to(root)
                pipeline.start_command = str(relative_launcher)
                suffix = workflow_args.get(directory.name)
                if isinstance(suffix, str) and suffix:
                    pipeline.start_command += f" {suffix}"
            try:
                run_logs = sorted(directory.glob("logs/run-*.log"), key=lambda path: path.stat().st_mtime)
                pipeline.run_count = len(run_logs)
                if run_logs:
                    newest = run_logs[-1]
                    finished = datetime.fromtimestamp(newest.stat().st_mtime).astimezone()
                    pipeline.last_run_at = finished.isoformat()
                    lines = [line.strip() for line in newest.read_text(errors="replace").splitlines() if line.strip()]
                    if lines:
                        pipeline.last_line = lines[-1][:120]
                queue = directory / "state" / "queue"
                if queue.is_dir():
                    pipeline.queued = sum(1 for item in queue.iterdir() if not item.name.startswith("."))
                reviews = directory / "state" / "reviews"
                if reviews.is_dir():
                    pipeline.review_files = sum(
                        1 for item in reviews.rglob("*") if item.is_file() and not item.name.startswith(".")
                    )
            except OSError:
                pass
            pipelines.append(pipeline)

    pipelines.extend(configured_pipelines(root, config))
    return pipelines


