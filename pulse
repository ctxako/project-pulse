@dataclass
class Repo:
    name: str
    path: str
    branch: str = "unknown"
    upstream: str | None = None
    ahead: int = 0
    behind: int = 0
    staged: int = 0
    unstaged: int = 0
    untracked: int = 0
    conflicted: int = 0
    remote: str | None = None
    local_only: bool = False
    last_commit_at: str | None = None
    age_days: int | None = None
    has_readme: bool = False
    has_workflow: bool = False
    has_tests: bool = False
    technology: str = "repo"

    @property
    def changed(self) -> int:
        return self.staged + self.unstaged + self.untracked + self.conflicted

    @property
    def clean(self) -> bool:
        return self.changed == 0


@dataclass
class Recommendation:
    score: int
    category: str
    title: str
    detail: str
    command: str | None = None
    repo: str | None = None
    source: str = "local"
    prompt: str | None = None  # ideas ship their own build-it prompt; git moves do not

    @property
    def id(self) -> str:
        identity = "\x1f".join((self.category, self.repo or "", self.title, self.detail))
        return hashlib.sha256(identity.encode()).hexdigest()[:12]


