def repo_state(repo: Repo) -> str:
    if repo.conflicted:
        return "conflict"
    if repo.changed:
        return f"{repo.changed} changes"
    if repo.ahead or repo.behind:
        return f"+{repo.ahead}/-{repo.behind}"
    return "clean"


def print_repos(repos: list[Repo], palette: Palette) -> None:
    print(palette.bold(f"{len(repos)} ACTIVE REPOSITORIES"))
    print()
    width = min(34, max([len(repo.name) for repo in repos] + [4]))
    for repo in repos:
        if repo.remote:
            remote = "remote"
        else:
            remote = "local-only (declared)" if repo.local_only else "local-only"
        print(f"  {repo.name[:width]:<{width}}  {repo.branch[:24]:<24}  {repo_state(repo):<12}  {remote}")


def print_pipelines(pipelines: list[Pipeline], palette: Palette) -> None:
    print(palette.bold("AGENT PIPELINES"))
    print()
    width = max([len(pipeline.name) for pipeline in pipelines] + [4])
    for pipeline in pipelines:
        if pipeline.last_run_at is None:
            if pipeline.start_command:
                print(
                    f"  {pipeline.name:<{width}}  ready · start: {pipeline.start_command}"
                )
            else:
                print(f"  {pipeline.name:<{width}}  never run")
            continue
        ran = datetime.fromisoformat(pipeline.last_run_at).strftime("%a %b %-d, %-I:%M %p")
        pieces = [f"last ran {ran}", f"{pipeline.run_count} run(s)"]
        if pipeline.queued:
            pieces.append(f"{pipeline.queued} queued")
        if pipeline.review_files:
            pieces.append(f"{pipeline.review_files} review file(s)")
        print(f"  {pipeline.name:<{width}}  {' · '.join(pieces)}")
        if pipeline.last_line:
            print(f"  {'':<{width}}  {palette.dim('last word: ' + pipeline.last_line)}")
    print()


