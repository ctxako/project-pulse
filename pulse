        ("╭─────╮", "│  >  │", "╰─────╯"),
        ("╭─────╮", "│ >>  │", "╰─────╯"),
    ),
}
AGENT_ICON_EMPTY = ("╭─────╮", "│     │", "╰─────╯")  # the guard an empty position keeps
AGENT_ICON_WIDTH = 7
AGENT_STRIP_ROWS = 7  # provider mark, three icon rows, project, time in state, activity
AGENT_BAND_ACTIVE_ROWS = 1 + AGENT_STRIP_ROWS
AGENT_BAND_COLLAPSED_ROWS = 1
AGENT_STRIP_MIN_WIDTH = 10
AGENT_GRID_MIN_COLUMNS = 2
AGENT_GRID_MAX_COLUMNS = 6
AGENT_INSTRUMENT_CODE = "AGT/01"


def agent_icon_frame(state: str, frame: int) -> tuple[str, str, str]:
    frames = AGENT_ICON_FRAMES.get(state) or AGENT_ICON_FRAMES["still"]
    return frames[frame % len(frames)]


def agent_grid_columns(width: int) -> int:
    """Fit whole cards only: 60→6, 50→5, 40→4, 30→3, 20→2."""
    return min(AGENT_GRID_MAX_COLUMNS, width // AGENT_STRIP_MIN_WIDTH)


def agent_strip_width(
    width: int,
    columns: int = AGENT_GRID_MAX_COLUMNS,
    framed: bool = True,
) -> int:
    """One equal card width, reserving exterior walls only in the wide layout."""
    return (width - 2 if framed else width) // columns


def agent_band_height(band: AgentBand | None) -> int:
    return AGENT_BAND_ACTIVE_ROWS if band is not None and band.active else AGENT_BAND_COLLAPSED_ROWS


def agent_time_in_state(now: datetime, since: datetime | None) -> str:
    if since is None:
        return "0:00"
    seconds = max(0, int((now - since).total_seconds()))
    if seconds < 3600:
        return f"{seconds // 60}:{seconds % 60:02d}"
    hours, rest = divmod(seconds, 3600)
    return f"{hours}h{rest // 60:02d}"


def agent_strip_cells(strip: AgentStrip | None, width: int, frame: int, now: datetime) -> list[str]:
    """Seven plain rows, each exactly `width` cells, for one position."""
    inset = max(0, (width - AGENT_ICON_WIDTH) // 2)
    room = width - inset

    def line(value: str) -> str:
        return (" " * inset + clip_text(value, room)).ljust(width)[:width]

    if strip is None:
        return [line("")] + [line(row) for row in AGENT_ICON_EMPTY] + [line("")] * 3
    session = strip.session
    mark = session.provider.upper() + (f" +{session.subagents}" if session.subagents else "")
    icon = agent_icon_frame("still" if strip.fading else session.state, frame)
    return [
        line(mark),
        *[line(row) for row in icon],
        line(session.project),
        line(agent_time_in_state(now, session.state_since)),  # the icon is the state; this is how long
        line(session.activity),
    ]


def paint_agent_cell(
    palette: Palette, strip: AgentStrip | None, row: int, value: str, frame: int
) -> str:
    """Paint the card as a quiet field, reserving color for a human handoff.

    The glyph already says what an active session is doing. Giving every
    provider state its own color made a six-card grid read like a legend before
    it read like a field. A still card breathes very slowly in graphite; every
    working glyph uses the same bright ink. Pink is deliberately exceptional:
    it means the session is waiting on its person.
    """
    if strip is None:
        return palette.dim(palette.muted(value)) if 1 <= row <= 3 else value
    if strip.fading:
        return palette.dim(palette.muted(value))
    if row == 0:
        return palette.muted(value)
    if 1 <= row <= 3:
        if strip.session.state == "waiting":
            return palette.bold(palette.signal(value))
        # Quiet cards do not pretend to be active. Their outline lifts once
        # every four ticks, enough to keep the field from feeling dead without
        # creating cursor-like noise.
        if strip.session.state == "still":
            return palette.fog(value) if frame % 4 == 0 else palette.muted(value)
        return palette.fog(value)
    if row == 4:
        return palette.bold(palette.fog(value))
    return palette.dim(palette.muted(value))


def paint_agent_instrument(palette: Palette, value: str) -> str:
    """Paint fixed technical frame marks in foreground-only graphite."""
    return palette.muted(value)


def agent_frame_marks(framed: bool) -> tuple[str, str]:
    """The full-height side walls that sit outside the six agent cards."""
    return ("│", "│") if framed else ("", "")


def agent_band_strips(band: AgentBand) -> list[AgentStrip]:
    """The stable first row followed by live overflow, in admission order."""
    strips = [strip for strip in band.positions if strip]
    strips.extend(AgentStrip(band.sessions[key]) for key in band.queue if key in band.sessions)
    return strips


def agent_band_header(
    palette: Palette,
    occupied: int,
    queued: int,
    attention: int,
    width: int,
    framed: bool,
) -> str:
    """A compact equipment label around the existing session count."""
    sessions = f"{occupied:02d} SESSIONS"
    if attention:
        sessions += f" / {attention:02d} NEEDS YOU"
    if queued:
        sessions += f" / +{queued} QUEUED"
    if not framed:
        left = "// LIVE AGENTS"
        right = f"{AGENT_INSTRUMENT_CODE} // {sessions}"
        if len(left) + len(right) + 1 > width:
            right = f"{occupied:02d}" + ("!" if attention else "") + (f"/+{queued}" if queued else "")
        plain = spread_line(left, right, width)
        split_at = plain.rfind(right)
        return palette.bold(palette.fog(plain[:split_at])) + palette.muted(plain[split_at:])
    left = "┌─ // LIVE AGENTS"
    right = f"{AGENT_INSTRUMENT_CODE} // {sessions} ─┐"
    plain = rule_line(left, right, width)
    split_at = plain.rfind(right)
    return (
        palette.bold(palette.fog(plain[: len(left)]))
        + palette.muted(plain[len(left) : split_at])
        + palette.fog(plain[split_at:])
    )


def agent_band_rows(
    band: AgentBand | None,
    palette: Palette,
    width: int,
    frame: int = 0,
    now: datetime | None = None,
    columns: int = AGENT_GRID_MAX_COLUMNS,
    grid_rows: int = 1,
    framed: bool = True,
) -> list[str]:
    """Render as many complete, equal card rows as the caller gives us."""
    now = now or datetime.now(timezone.utc)
    if band is None or not band.active:
        line = spread_line("// LIVE AGENTS", "STANDBY // 00 SESSIONS", width)
        return [palette.muted(line)]
    columns = max(AGENT_GRID_MIN_COLUMNS, min(AGENT_GRID_MAX_COLUMNS, columns))
    strip_width = agent_strip_width(width, columns, framed)
    capacity = columns * max(1, grid_rows)
    strips = agent_band_strips(band)
    used_rows = min(max(1, grid_rows), max(1, (len(strips) + columns - 1) // columns))
    capacity = columns * used_rows
    shown = strips[:capacity]
    queued = max(0, len(strips) - len(shown))
    attention = sum(
        strip is not None and not strip.fading and strip.session.state == "waiting" for strip in shown
    )
    rows = [agent_band_header(palette, len(shown), queued, attention, width, framed)]
    spare = width - (2 if framed else 0) - strip_width * columns
    for grid_row in range(used_rows):
        row_strips = shown[grid_row * columns : (grid_row + 1) * columns]
        row_strips += [None] * (columns - len(row_strips))
        cells = [agent_strip_cells(strip, strip_width, frame, now) for strip in row_strips]
        for row in range(AGENT_STRIP_ROWS):
            left, right = agent_frame_marks(framed)
            body = "".join(
                paint_agent_cell(palette, strip, row, cell[row], frame)
                for strip, cell in zip(row_strips, cells)
            )
            rows.append(
                paint_agent_instrument(palette, left)
                + body
                + " " * spare
                + paint_agent_instrument(palette, right)
            )
    return rows


