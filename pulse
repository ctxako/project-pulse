@dataclass
class AgentEvent:
    """One thing a session did, reduced to what the band may show.

    `label` is a tool name or a file basename — never a prompt, an argument,
    an answer, or a full path. `key` pairs a question with its answer and a
    subagent's start with its end.
    """

    at: datetime
    kind: str  # activity | edit | question | answer | turn_end | subagent_start | subagent_end
    label: str = ""
    key: str | None = None


@dataclass
class AgentObservation:
    """One provider session as seen on this scan, with the events appended since the last."""

    provider: str  # claude | codex
    session_id: str
    project: str
    started_at: datetime
    trail: Path | None = None
    parent_id: str | None = None  # a Codex child thread; never gets a strip of its own
    status: str | None = None  # the provider's own word for it, if it has one
    events: list[AgentEvent] = field(default_factory=list)

    @property
    def key(self) -> str:
        return f"{self.provider}:{self.session_id}"


class TrailCursor:
    """Byte offset into one JSONL trail; only complete appended lines are parsed."""

    def __init__(self, path: Path):
        self.path = path
        self.offset = 0
        self.last_seen = 0.0

    def read_new_records(self) -> list[dict[str, Any]]:
        try:
            size = self.path.stat().st_size
            if size < self.offset:
                self.offset = 0  # rewritten or truncated: start over rather than mid-record
            if size == self.offset:
                return []
            with self.path.open("rb") as handle:
                handle.seek(self.offset)
                chunk = handle.read(size - self.offset)
        except OSError:
            return []
        complete = chunk.rfind(b"\n")
        if complete < 0:
            return []  # a record still being written; wait for its newline
        self.offset += complete + 1
        records: list[dict[str, Any]] = []
        for line in chunk[:complete].split(b"\n"):
            if not line.strip():
                continue
            try:
                record = json.loads(line)
            except (ValueError, UnicodeDecodeError):
                continue
            if isinstance(record, dict):
                records.append(record)
        return records


def parse_agent_timestamp(value: Any, fallback: datetime) -> datetime:
    if isinstance(value, (int, float)):
        seconds = value / 1000 if value > 1e11 else value  # epoch millis vs seconds
        try:
            return datetime.fromtimestamp(seconds, tz=timezone.utc)
        except (OverflowError, OSError, ValueError):
            return fallback
    if isinstance(value, str) and value:
        try:
            parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
        except ValueError:
            return fallback
        return parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)
    return fallback


def agent_project_name(cwd: Any, root: Path) -> str:
    """The workspace folder a session works in, never the full path."""
    if not isinstance(cwd, str) or not cwd:
        return "?"
    path = Path(cwd)
    try:
        relative = path.resolve().relative_to(root.resolve())
    except (OSError, ValueError, RuntimeError):
        return path.name or "?"
    if not relative.parts:
        return root.name or "?"
    return relative.parts[0]


def sanitized_basename(value: Any) -> str:
    if not isinstance(value, str) or not value:
        return ""
    return Path(value).name


def claude_events(record: dict[str, Any], now: datetime) -> list[AgentEvent]:
    """Normalize one Claude Code trail record. Unknown shapes yield nothing."""
    if record.get("isSidechain"):
        return []  # a subagent's own turns, folded into the parent by its Agent call
    at = parse_agent_timestamp(record.get("timestamp"), now)
    kind = record.get("type")
    message = record.get("message")
    content = message.get("content") if isinstance(message, dict) else None
    events: list[AgentEvent] = []
    if kind == "assistant":
        blocks = content if isinstance(content, list) else []
        for block in blocks:
            if not isinstance(block, dict) or block.get("type") != "tool_use":
                continue
            name = block.get("name")
            call_id = block.get("id") if isinstance(block.get("id"), str) else None
            arguments = block.get("input") if isinstance(block.get("input"), dict) else {}
            if not isinstance(name, str):
                continue
            if name in CLAUDE_EDIT_TOOLS:
                events.append(AgentEvent(at, "edit", sanitized_basename(arguments.get("file_path")) or name))
            elif name == CLAUDE_QUESTION_TOOL:
                events.append(AgentEvent(at, "question", name, call_id))
            elif name == CLAUDE_SUBAGENT_TOOL:
                events.append(AgentEvent(at, "subagent_start", name, call_id))
            else:
                events.append(AgentEvent(at, "activity", name))
        if not events:
            if message.get("stop_reason") == "end_turn" if isinstance(message, dict) else False:
                events.append(AgentEvent(at, "turn_end"))
            else:
                events.append(AgentEvent(at, "activity", "reasoning"))
    elif kind == "user":
        if isinstance(content, list):
            for block in content:
                if isinstance(block, dict) and block.get("type") == "tool_result":
                    key = block.get("tool_use_id")
                    events.append(AgentEvent(at, "answer", "", key if isinstance(key, str) else None))
            if not events:
                events.append(AgentEvent(at, "activity", "prompt"))
        elif isinstance(content, str):
            events.append(AgentEvent(at, "activity", "prompt"))
    elif kind == "system" and record.get("subtype") == "turn_duration":
        events.append(AgentEvent(at, "turn_end"))
    return events


def codex_events(record: dict[str, Any], now: datetime) -> list[AgentEvent]:
    """Normalize one Codex rollout record. Unknown shapes yield nothing."""
    at = parse_agent_timestamp(record.get("timestamp"), now)
    payload = record.get("payload")
    if not isinstance(payload, dict):
        return []
    kind = record.get("type")
    item_type = payload.get("type")
    if kind == "response_item":
        if item_type in ("function_call", "custom_tool_call"):
            name = payload.get("name")
            call_id = payload.get("call_id") if isinstance(payload.get("call_id"), str) else None
            if not isinstance(name, str):
                return []
            if name == CODEX_QUESTION_TOOL:
                return [AgentEvent(at, "question", name, call_id)]
            if name in CODEX_EDIT_TOOLS:
                return [AgentEvent(at, "edit", name)]
            return [AgentEvent(at, "activity", name)]
        if item_type in ("function_call_output", "custom_tool_call_output"):
            call_id = payload.get("call_id")
            return [AgentEvent(at, "answer", "", call_id if isinstance(call_id, str) else None)]
        if item_type == "reasoning":
            return [AgentEvent(at, "activity", "reasoning")]
        if item_type == "message":
            role = payload.get("role")
            if role == "assistant":
                return [AgentEvent(at, "activity", "message")]
            if role == "user":
                return [AgentEvent(at, "activity", "prompt")]
        return []
    if kind == "event_msg":
        if item_type in ("task_complete", "turn_aborted"):
            return [AgentEvent(at, "turn_end")]
        if item_type == "task_started":
            return [AgentEvent(at, "activity", "turn")]
        if item_type in CODEX_APPROVAL_EVENTS:
            call_id = payload.get("call_id")
            return [AgentEvent(at, "question", item_type, call_id if isinstance(call_id, str) else None)]
        if item_type in CODEX_APPROVAL_DECISIONS:
            call_id = payload.get("call_id")
            events = [AgentEvent(at, "answer", "", call_id if isinstance(call_id, str) else None)]
            if item_type == "patch_apply_end":
                events.append(AgentEvent(at, "edit", "patch"))
            return events
        if item_type == "item_completed":
            item = payload.get("item")
            if not isinstance(item, dict):
                return []
            item_kind = item.get("type")
            if item_kind == "FileChange":
                changes = item.get("changes")
                first = next(iter(changes), "") if isinstance(changes, dict) else ""
                return [AgentEvent(at, "edit", sanitized_basename(first) or "patch")]
            if item_kind == "CommandExecution":
                return [AgentEvent(at, "activity", "command")]
            if item_kind in ("Reasoning", "AgentMessage", "Plan"):
                return [AgentEvent(at, "activity", item_kind.lower())]
            if item_kind == "UserMessage":
                return [AgentEvent(at, "activity", "prompt")]
            return []
        if item_type == "agent_reasoning":
            return [AgentEvent(at, "activity", "reasoning")]
        if item_type == "user_message":
            return [AgentEvent(at, "activity", "prompt")]
        if item_type == "agent_message":
            return [AgentEvent(at, "activity", "message")]
    return []


def claude_trail_path(home: Path, session_id: str) -> Path | None:
    """The project slug mangles `/`, `.`, and `_` alike, so match by session ID instead."""
    projects = home / ".claude" / "projects"
    try:
        matches = [path for path in projects.glob(f"*/{session_id}.jsonl") if path.is_file()]
    except OSError:
        return None
    if not matches:
        return None
    return max(matches, key=lambda path: path.stat().st_mtime)


def read_claude_inventory() -> list[dict[str, Any]] | None:
    """Ask Claude Code which sessions exist, rather than trusting its stale registry.

    `~/.claude/sessions` is useful implementation detail but is not lifecycle
    authority: a record can remain after the terminal closes, and a recycled PID
    can make that old record look live again. `claude agents --json` answers the
    one question this pane needs for admission: which sessions are running now.
    None means the command itself was unavailable or unreadable; callers fail
    closed instead of reviving a registry entry from an earlier session.
    """
    result = run(["claude", "agents", "--json"], timeout=CLAUDE_INVENTORY_TIMEOUT_SECONDS)
    if result.returncode != 0:
        return None
    try:
        payload = json.loads(result.stdout or "[]")
    except ValueError:
        return None
    if not isinstance(payload, list):
        return None
    return [entry for entry in payload if isinstance(entry, dict)]


def claude_live_sessions(
    home: Path, root: Path, now: datetime, inventory: Iterable[dict[str, Any]]
) -> list[AgentObservation]:
    """Turn Claude's current inventory into band observations.

    Trails remain local and are only used for activity detail. Their presence,
    as well as the legacy on-disk session registry, never makes a card live.
    """
    observations: list[AgentObservation] = []
    seen: set[str] = set()
    for record in inventory:
        session_id = record.get("sessionId")
        if not isinstance(session_id, str) or not session_id or session_id in seen:
            continue
        seen.add(session_id)
        status = record.get("status")
        observations.append(
            AgentObservation(
                provider="claude",
                session_id=session_id,
                project=agent_project_name(record.get("cwd"), root),
                started_at=parse_agent_timestamp(record.get("startedAt"), now),
                trail=claude_trail_path(home, session_id),
                status=status if isinstance(status, str) else None,
            )
        )
    return observations


def codex_session_index(home: Path) -> dict[str, dict[str, Any]]:
    """The newest index entry per thread; the index appends a line per rename."""
    index: dict[str, dict[str, Any]] = {}
    path = home / ".codex" / "session_index.jsonl"
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return index
    for line in text.splitlines():
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if isinstance(entry, dict) and isinstance(entry.get("id"), str):
            index[entry["id"]] = entry
    return index


def codex_rollout_path(home: Path, session_id: str) -> Path | None:
    sessions = home / ".codex" / "sessions"
    try:
        matches = [path for path in sessions.glob(f"*/*/*/rollout-*-{session_id}.jsonl") if path.is_file()]
    except OSError:
        return None
    if not matches:
        return None
    return max(matches, key=lambda path: path.stat().st_mtime)


def codex_session_meta(path: Path) -> dict[str, Any] | None:
    """The first rollout line; read alone because it carries the full base instructions."""
    try:
        with path.open("rb") as handle:
            first = handle.readline()
        record = json.loads(first)
    except (OSError, ValueError, UnicodeDecodeError):
        return None
    if not isinstance(record, dict) or record.get("type") != "session_meta":
        return None
    payload = record.get("payload")
    return payload if isinstance(payload, dict) else None


def codex_lock_held(lock: Path) -> bool:
    """Whether some process holds the advisory lock on a Codex thread-writer lock file.

    The file is empty; the lock lives in the kernel and is released the moment
    the holder exits, so a shared non-blocking probe distinguishes a running
    thread from a lock left behind. Verified both ways against codex-cli
    0.151.0: held from the thread's first tenth of a second, deleted on a
    clean exit, left on disk and unheld when the terminal is closed on it.
    Any error other than contention counts as held, so an odd filesystem
    shows a session rather than hiding one.
    """
    try:
        descriptor = os.open(lock, os.O_RDONLY)
    except OSError:
        return True
    try:
        fcntl.flock(descriptor, fcntl.LOCK_SH | fcntl.LOCK_NB)
    except OSError:
        return True  # contention means a live holder; anything else is not proof of absence
    else:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_UN)
        except OSError:
            pass
        return False
    finally:
        os.close(descriptor)


def codex_live_sessions(home: Path, root: Path, now: datetime) -> list[AgentObservation]:
    locks = home / ".codex" / "thread-writer-locks"
    observations: list[AgentObservation] = []
    try:
        lock_files = sorted(locks.glob("*.lock"))
    except OSError:
        return observations
    index = codex_session_index(home) if lock_files else {}
    for lock in lock_files:
        if lock.name.startswith("."):
            continue  # .coordination.lock guards the directory, not a thread
        session_id = lock.stem
        trail = codex_rollout_path(home, session_id)
        if trail is None or not codex_lock_held(lock):
            continue  # a lock nobody holds is one a killed thread left behind
        meta = codex_session_meta(trail)
        if meta is None:
            continue
        parent = meta.get("parent_thread_id")
        indexed = index.get(session_id, {})
        started = parse_agent_timestamp(meta.get("timestamp"), parse_agent_timestamp(indexed.get("updated_at"), now))
        observations.append(
            AgentObservation(
                provider="codex",
                session_id=session_id,
                project=agent_project_name(meta.get("cwd"), root),
                started_at=started,
                trail=trail,
                parent_id=parent if isinstance(parent, str) and parent else None,
            )
        )
    return observations


class AgentCollector:
    """Enumerates live sessions each tick and drains their trails incrementally.

    Cursors outlive a scan that misses their session — a lock or registry
    file can vanish for a moment — so a returning session picks up where it
    left off instead of replaying its whole trail.
    """

    def __init__(self, home: Path | None = None, root: Path | None = None):
        self.home = home or Path.home()
        self.root = root or self.home / "Projects"
        self.cursors: dict[str, TrailCursor] = {}
        self.claude_inventory: list[dict[str, Any]] | None = None
        self.claude_inventory_at: float | None = None

    def claude_sessions(self, now: datetime) -> list[AgentObservation]:
        """Refresh the independent Claude inventory at a bounded cadence.

        The pane redraws every second, but starting a CLI process every second
        would be disproportionate. Five seconds is short enough for a closed
        card to disperse promptly and keeps the provider query off the hot path.
        """
        clock = time.monotonic()
        if (
            self.claude_inventory_at is None
            or clock - self.claude_inventory_at >= CLAUDE_INVENTORY_REFRESH_SECONDS
        ):
            self.claude_inventory = read_claude_inventory()
            self.claude_inventory_at = clock
        return claude_live_sessions(self.home, self.root, now, self.claude_inventory or [])

    def scan(self, now: datetime | None = None) -> list[AgentObservation]:
        now = now or datetime.now(timezone.utc)
        observations: list[AgentObservation] = []
        try:
            observations.extend(self.claude_sessions(now))
        except Exception:  # noqa: BLE001 - the band must never take the dashboard down
            pass
        try:
            observations.extend(codex_live_sessions(self.home, self.root, now))
        except Exception:  # noqa: BLE001 - the band must never take the dashboard down
            pass
        clock = time.monotonic()
        for observation in observations:
            if observation.trail is None:
                continue
            cursor = self.cursors.get(observation.key)
            if cursor is None or cursor.path != observation.trail:
                cursor = self.cursors[observation.key] = TrailCursor(observation.trail)
            cursor.last_seen = clock
            normalize = claude_events if observation.provider == "claude" else codex_events
            for record in cursor.read_new_records():
                try:
                    observation.events.extend(normalize(record, now))
                except Exception:  # noqa: BLE001 - one odd record is not a reason to stop
                    continue
        for key in [key for key, cursor in self.cursors.items() if clock - cursor.last_seen > AGENT_CURSOR_TTL_SECONDS]:
            del self.cursors[key]
        return observations


AGENT_FINISHING_SECONDS = 120
AGENT_FADE_SECONDS = 5
AGENT_BAND_POSITIONS = 6  # the stable first row; the renderer can reveal queued rows


@dataclass
class AgentSession:
    """A top-level session as the band shows it."""

    provider: str
    session_id: str
    project: str
    started_at: datetime
    state: str = "still"
    state_since: datetime | None = None
    activity: str = ""
    subagents: int = 0

    @property
    def key(self) -> str:
        return f"{self.provider}:{self.session_id}"


class AgentLedger:
    """Reduces one session's events into a state, with strict waiting precedence.

    Waiting is only ever an unmatched question — a user prompt the agent put up
    and has not had answered. While one is open, nothing else the trail says
    can move the state; the answer (matched by key) releases it. Silence is
    never waiting. Finishing owns the state for exactly
    AGENT_FINISHING_SECONDS, then falls back to still.
    """

    def __init__(self, started_at: datetime):
        self.state = "still"
        self.state_since = started_at
        self.activity = ""
        self.open_questions: set[str] = set()
        self.unkeyed_questions = 0
        self.open_subagents: set[str] = set()

    @property
    def waiting(self) -> bool:
        return bool(self.open_questions) or self.unkeyed_questions > 0

    def move(self, state: str, at: datetime, activity: str | None = None) -> None:
        if state not in AGENT_STATES:
            state = "still"
        if state != self.state:
            self.state = state
            self.state_since = at
        if activity is not None:
            self.activity = activity

    def apply(self, event: AgentEvent) -> None:
        at = event.at
        if event.kind == "question":
            if event.key:
                self.open_questions.add(event.key)
            else:
                self.unkeyed_questions += 1
            self.move("waiting", at, event.label or "question")
            return
        if event.kind == "answer":
            released = False
            if event.key and event.key in self.open_questions:
                self.open_questions.discard(event.key)
                released = True
            elif event.key and event.key in self.open_subagents:
                self.open_subagents.discard(event.key)
            elif self.unkeyed_questions:
                self.unkeyed_questions -= 1
                released = True
            if self.waiting:
                return
            if released:
                self.move("thinking", at, "answered")
            elif self.state == "waiting":
                self.move("thinking", at)
            else:
                self.move("thinking", at, self.activity)
            return
        if self.waiting:
            return  # an open question outranks anything else the trail says
        if event.kind == "subagent_start":
            if event.key:
                self.open_subagents.add(event.key)
            self.move("thinking", at, event.label or "Agent")
        elif event.kind == "subagent_end":
            if event.key:
                self.open_subagents.discard(event.key)
        elif event.kind == "edit":
            self.move("editing", at, event.label)
        elif event.kind == "turn_end":
            self.move("finishing", at, "turn done")
        elif event.kind == "activity":
            self.move("thinking", at, event.label)

    def settle(self, now: datetime) -> None:
        """Finishing is a timed celebration; time it out even without new events."""
        if self.state == "finishing" and (now - self.state_since).total_seconds() >= AGENT_FINISHING_SECONDS:
            self.state = "still"
            self.state_since = self.state_since + timedelta(seconds=AGENT_FINISHING_SECONDS)
            self.activity = ""


@dataclass
class AgentStrip:
    session: AgentSession
    closed_at: datetime | None = None  # the fade began; the position frees AGENT_FADE_SECONDS later

    @property
    def fading(self) -> bool:
        return self.closed_at is not None


class AgentBand:
    """Six stable positions, admitted FIFO by start time, never rearranged.

    An occupant keeps its position until it has been gone for the fade. A
    still-live session can keep its finishing celebration, but provider
    absence always begins the fade. Overflow queues FIFO; the header says how
    many, and the oldest queued session that is still live takes the exact
    position that opens.
    """

    def __init__(self, positions: int = AGENT_BAND_POSITIONS):
        self.positions: list[AgentStrip | None] = [None] * positions
        self.queue: list[str] = []
        self.ledgers: dict[str, AgentLedger] = {}
        self.sessions: dict[str, AgentSession] = {}

    @property
    def active(self) -> bool:
        return any(self.positions)

    @property
    def queued(self) -> int:
        return len(self.queue)

    def placed(self) -> set[str]:
        return {strip.session.key for strip in self.positions if strip}

    def update(self, observations: list[AgentObservation], now: datetime) -> None:
        children: dict[str, int] = {}
        for observation in observations:
            if observation.parent_id:
                children[f"{observation.provider}:{observation.parent_id}"] = (
                    children.get(f"{observation.provider}:{observation.parent_id}", 0) + 1
                )
        live: dict[str, AgentObservation] = {
            observation.key: observation for observation in observations if not observation.parent_id
        }
        for key, observation in live.items():
            ledger = self.ledgers.get(key)
            if ledger is None:
                ledger = self.ledgers[key] = AgentLedger(observation.started_at)
            for event in observation.events:
                ledger.apply(event)
            ledger.settle(now)
            session = self.sessions.get(key)
            if session is None:
                session = self.sessions[key] = AgentSession(
                    observation.provider, observation.session_id, observation.project, observation.started_at
                )
            session.project = observation.project
            session.state = ledger.state
            session.state_since = ledger.state_since
            session.activity = ledger.activity
            session.subagents = len(ledger.open_subagents) + children.get(key, 0)

        for index, strip in enumerate(self.positions):
            if strip is None:
                continue
            key = strip.session.key
            if key in live:
                strip.closed_at = None
                continue
            ledger = self.ledgers.get(key)
            if ledger is not None:
                ledger.settle(now)
                strip.session.state = ledger.state
                strip.session.state_since = ledger.state_since
                strip.session.activity = ledger.activity
            if strip.closed_at is None:
                strip.closed_at = now
            elif (now - strip.closed_at).total_seconds() >= AGENT_FADE_SECONDS:
                self.positions[index] = None
                self.ledgers.pop(key, None)
                self.sessions.pop(key, None)

        self.queue = [key for key in self.queue if key in live]  # a queued session that closed is skipped
        placed = self.placed()
        arriving = sorted(
            (key for key in live if key not in placed and key not in self.queue),
            key=lambda key: (live[key].started_at, key),
        )
        self.queue.extend(arriving)
        for index, strip in enumerate(self.positions):
            if strip is None and self.queue:
                self.positions[index] = AgentStrip(self.sessions[self.queue.pop(0)])
        for key in [key for key in self.ledgers if key not in live and key not in self.placed()]:
            self.ledgers.pop(key, None)
            self.sessions.pop(key, None)


def parse_gh_json(arguments: list[str]) -> tuple[list[dict[str, Any]], str | None]:
    result = run(["gh", *arguments], timeout=15)
    if result.returncode != 0:
        return [], result.stderr.strip() or "GitHub command failed"
    try:
        payload = json.loads(result.stdout or "[]")
        return payload if isinstance(payload, list) else [], None
    except json.JSONDecodeError:
        return [], "GitHub returned an unreadable response"


def fetch_github(local_only: bool) -> GithubSnapshot:
    if local_only:
        return GithubSnapshot(available=False, error="Skipped with --local")
    if not shutil.which("gh"):
        return GithubSnapshot(available=False, error="GitHub CLI is not installed")

    auth = run(["gh", "auth", "status", "--hostname", "github.com"])
    if auth.returncode != 0:
        return GithubSnapshot(
            available=False,
            error="GitHub CLI needs authentication: gh auth login -h github.com",
        )

    user_result = run(["gh", "api", "user", "--jq", ".login"])
    if user_result.returncode != 0:
        return GithubSnapshot(available=False, error="GitHub is authenticated but the API is unreachable")
    user = user_result.stdout.strip()

    fields = "number,title,repository,url,updatedAt,isDraft"
    open_prs, pr_error = parse_gh_json(
        ["search", "prs", "--author", "@me", "--state", "open", "--limit", "50", "--json", fields]
    )
    reviews, review_error = parse_gh_json(
        ["search", "prs", "--review-requested", "@me", "--state", "open", "--limit", "50", "--json", fields]
    )
    error = pr_error or review_error
    return GithubSnapshot(
        available=error is None,
        user=user,
        open_prs=open_prs,
        review_requests=reviews,
        error=error,
    )


def shell_path(path: str) -> str:
    return "'" + path.replace("'", "'\\''") + "'"


def repo_recommendations(repo: Repo, starter_exists: bool = True) -> list[Recommendation]:
    recommendations: list[Recommendation] = []
    cd = f"cd {shell_path(repo.path)}"

    if repo.conflicted:
        recommendations.append(Recommendation(
            120, "hygiene", f"Resolve the interrupted Git operation in {repo.name}",
            f"{repo.conflicted} conflicted path(s) are keeping this repository in limbo.",
            f"{cd} && git status", repo.name,
        ))
    elif repo.changed:
        pieces = []
        if repo.staged:
            pieces.append(f"{repo.staged} staged")
        if repo.unstaged:
            pieces.append(f"{repo.unstaged} modified")
        if repo.untracked:
            pieces.append(f"{repo.untracked} untracked")
        recommendations.append(Recommendation(
            94 + min(repo.changed, 15), "hygiene", f"Close the open loop in {repo.name}",
            f"Review {', '.join(pieces)} path(s), then commit, split, stash, or discard them intentionally.",
            f"{cd} && git status --short", repo.name,
        ))

    if repo.ahead:
        recommendations.append(Recommendation(
            96, "github", f"Publish {repo.name}'s local work",
            f"{repo.branch} is {repo.ahead} commit(s) ahead of {repo.upstream}.",
            f"{cd} && git push", repo.name,
        ))
    if repo.behind:
        recommendations.append(Recommendation(
            88, "github", f"Bring {repo.name} up to date",
            f"{repo.branch} is {repo.behind} commit(s) behind {repo.upstream}.",
            f"{cd} && git pull --ff-only", repo.name,
        ))
    if not repo.remote and not repo.local_only:
        recommendations.append(Recommendation(
            82, "github", f"Decide whether {repo.name} belongs on GitHub",
            "This repository has no origin remote. Publish it or explicitly keep it local-only.",
            f"{cd} && git remote -v", repo.name,
        ))
    elif repo.branch not in MAIN_BRANCHES and not repo.upstream:
        recommendations.append(Recommendation(
            90, "github", f"Give {repo.name}'s branch a destination",
            f"{repo.branch} has no upstream. Push it for a PR, merge it locally, or park it deliberately.",
            f"{cd} && git status -sb", repo.name,
        ))
    elif repo.branch not in MAIN_BRANCHES and repo.clean and (repo.age_days or 0) >= 10:
        recommendations.append(Recommendation(
            84, "github", f"Decide the fate of {repo.name}'s branch",
            f"{repo.branch} is clean but its last commit was {repo.age_days} days ago.",
            f"{cd} && git log --oneline --decorate -8", repo.name,
        ))

    # Suppressed while no repo in the workspace has a workflow yet: there is no
    # starter to copy, so the fleet-wide card in workspace_recommendations is the
    # honest first step and these would only duplicate it once per repo.
    if starter_exists and repo.has_tests and not repo.has_workflow:
        recommendations.append(Recommendation(
            62, "workflow", f"Put {repo.name}'s checks on autopilot",
            f"It looks like a {repo.technology} project with tests/checks but no GitHub Actions workflow.",
            f"{cd} && mkdir -p .github/workflows", repo.name,
        ))
    if repo.clean and not repo.has_readme:
        recommendations.append(Recommendation(
            46, "organize", f"Leave a map for future-you in {repo.name}",
            "Add a short README covering purpose, status, and the next meaningful action.",
            f"{cd}", repo.name,
        ))
    return recommendations


def github_recommendations(snapshot: GithubSnapshot, now: datetime) -> list[Recommendation]:
    if not snapshot.available:
        return []
    recommendations: list[Recommendation] = []
    for pr in snapshot.review_requests or []:
        repository = (pr.get("repository") or {}).get("nameWithOwner", "GitHub")
        recommendations.append(Recommendation(
            102, "github", f"Review {repository}#{pr.get('number')}",
            pr.get("title", "A pull request is waiting for you."),
            f"gh pr view {pr.get('number')} --repo {repository} --web", repository, "github",
        ))
    for pr in snapshot.open_prs or []:
        updated = pr.get("updatedAt")
        age = 0
        if updated:
            try:
                age = (now - datetime.fromisoformat(updated.replace("Z", "+00:00"))).days
            except ValueError:
                pass
        if pr.get("isDraft") or age >= 4:
            repository = (pr.get("repository") or {}).get("nameWithOwner", "GitHub")
            state = "draft" if pr.get("isDraft") else f"quiet for {age} days"
            recommendations.append(Recommendation(
                86 + min(age, 10), "github", f"Unstick {repository}#{pr.get('number')}",
                f"This PR is {state}: {pr.get('title', 'untitled')}",
                f"gh pr view {pr.get('number')} --repo {repository} --web", repository, "github",
            ))
    return recommendations


def workspace_recommendations(root: Path, repos: list[Repo]) -> list[Recommendation]:
    recommendations: list[Recommendation] = []
    recipes = sorted((root / "Scripts").glob("*.rtf")) if (root / "Scripts").is_dir() else []
    if recipes:
        names = ", ".join(path.stem for path in recipes[:3])
        recommendations.append(Recommendation(
            70, "terminal", "Promote one terminal recipe into a real command",
            f"Your Scripts folder still has {len(recipes)} RTF recipe(s): {names}. Make the most-used one executable and searchable.",
            f"cd {shell_path(str(root / 'Scripts'))}",
        ))

    workflow_count = sum(repo.has_workflow for repo in repos)
    testable = sum(repo.has_tests for repo in repos)
    if testable and workflow_count == 0:
        recommendations.append(Recommendation(
            68, "workflow", "Build one reusable GitHub Actions starter",
            f"None of these {len(repos)} active repos has a workflow, while {testable} appear to expose tests or checks.",
            f"cd {shell_path(str(root / '_tools'))}",
        ))

    clean_old = [repo for repo in repos if repo.clean and (repo.age_days or 0) >= 60]
    if clean_old:
        oldest = max(clean_old, key=lambda repo: repo.age_days or 0)
        recommendations.append(Recommendation(
            52, "organize", f"Give {oldest.name} an explicit status",
            f"It is clean and has been quiet for {oldest.age_days} days. Mark it active, paused, or archived without changing its code.",
            f"cd {shell_path(oldest.path)} && git log -1 --oneline", oldest.name,
        ))

    return recommendations


def all_recommendations(root: Path, repos: list[Repo], github: GithubSnapshot) -> list[Recommendation]:
    starter_exists = any(repo.has_workflow for repo in repos)
    items = [item for repo in repos for item in repo_recommendations(repo, starter_exists)]
    items.extend(github_recommendations(github, datetime.now(timezone.utc)))
    items.extend(workspace_recommendations(root, repos))
    return sorted(items, key=lambda item: (-item.score, item.category, item.title.lower()))


def select_recommendations(items: list[Recommendation], vibe: str, limit: int) -> list[Recommendation]:
    if vibe != "anything":
        return [item for item in items if item.category == vibe][:limit]
    if not items:
        return []

    selected: list[Recommendation] = []
    used_categories: set[str] = set()
    used_repos: set[str] = set()
    for item in items:
        if item.category in used_categories or (item.repo and item.repo in used_repos):
            continue
        selected.append(item)
        used_categories.add(item.category)
        if item.repo:
            used_repos.add(item.repo)
        if len(selected) >= limit:
            return selected
    for item in items:
        if item not in selected and (not item.repo or item.repo not in used_repos):
            selected.append(item)
            if item.repo:
                used_repos.add(item.repo)
        if len(selected) >= limit:
            break
    return selected


# --------------------------------------------------------------------------
# The ideas band
#
# Everything above this point is derived: pulse reads local state and says what
# that state implies. Nothing in git can imply "write an agent for this", so the
# band below is written by a model, on request only, and persists verbatim until
# the user asks for another pass. Pulse never regenerates it on its own — no
# timer, no scan trigger — because an idea list that churns underneath you is
# the thing this band exists to avoid.
# --------------------------------------------------------------------------


class IdeaError(RuntimeError):
    """A refresh that could not produce trustworthy ideas. Stored ideas survive."""


def load_ideas(path: Path) -> dict[str, Any]:
    stored = read_state(path).get("ideas")
    if not isinstance(stored, dict):
        return {"items": [], "done": []}
    items = [entry for entry in stored.get("items", []) if valid_idea(entry)]
    done = [entry for entry in stored.get("done", []) if isinstance(entry, dict) and isinstance(entry.get("id"), str)]
    return {**stored, "items": items, "done": done}


def save_ideas(path: Path, ideas: dict[str, Any]) -> None:
    write_state(path, {**read_state(path), "ideas": ideas})


def valid_idea(entry: Any) -> bool:
    if not isinstance(entry, dict):
        return False
    if entry.get("kind") not in IDEA_KINDS:
        return False
    return all(isinstance(entry.get(field), str) and entry[field].strip() for field in ("title", "detail", "prompt"))


def idea_recommendation(entry: dict[str, Any]) -> Recommendation:
    """An idea rides the Recommendation shape so numbering, dismissal, the
    listing file, and Enter-to-copy all work on it unchanged. It keeps its own
    list end to end, so it never competes with a dirty repo for a runway slot."""
    return Recommendation(
        score=0,
        category=entry["kind"],
        title=entry["title"].strip(),
        detail=entry["detail"].strip(),
        command=None,
        repo=None,
        source="idea",
        prompt=entry["prompt"].strip(),
    )


def visible_ideas(
    ideas: dict[str, Any], dismissals: list[dict[str, Any]], kind: str | None = None
) -> list[Recommendation]:
    hidden = {entry["id"] for entry in dismissals} | {entry["id"] for entry in ideas.get("done", [])}
    items = [idea_recommendation(entry) for entry in ideas.get("items", [])]
    return [item for item in items if item.id not in hidden and (kind is None or item.category == kind)]


def mark_idea_done(path: Path, ideas: dict[str, Any], item: Recommendation) -> dict[str, Any]:
    if any(entry["id"] == item.id for entry in ideas.get("done", [])):
        return ideas
    updated = {
        **ideas,
        "done": [
            *ideas.get("done", []),
            {
                "id": item.id,
                "title": item.title,
                "kind": item.category,
                "done_at": datetime.now(timezone.utc).isoformat(),
            },
        ],
    }
    save_ideas(path, updated)
    return updated


def read_head(path: Path, lines: int) -> str | None:
    try:
        with path.open(encoding="utf-8", errors="replace") as handle:
            return "".join(next(handle, "") for _ in range(lines)).strip() or None
    except OSError:
        return None


def workspace_tooling(root: Path, repos: list[Repo]) -> list[str]:
    """What the workspace can already do — so the model proposes something new."""
    names: list[str] = []
    for folder in ("_tools", "Scripts", DEFAULT_WORKFLOWS_DIR):
        directory = root / folder
        if not directory.is_dir():
            continue
        names.extend(
            f"{folder}/{entry.name}"
            for entry in sorted(directory.iterdir())
            if not entry.name.startswith(".")
        )
    if (root / "COMMANDS").is_file():
        names.append("COMMANDS")
    names.extend(f"{repo.name}/COMMANDS" for repo in repos if (Path(repo.path) / "COMMANDS").is_file())
    return names


def build_idea_pack(
    root: Path, repos: list[Repo], ideas: dict[str, Any], dismissals: list[dict[str, Any]], need: int
) -> dict[str, Any]:
    live = visible_ideas(ideas, dismissals)
    readmes: dict[str, str] = {}
    for repo in repos:
        readme = read_head(Path(repo.path) / "README.md", IDEA_README_LINES)
        if readme:
            readmes[repo.name] = readme
    ledger = None
    ledger_path = root / "LEDGER.md"
    if ledger_path.is_file():
        try:
            ledger = recent_ledger_entries(ledger_path.read_text(encoding="utf-8", errors="replace"))
        except OSError:
            ledger = None
    hidden = {entry["id"] for entry in dismissals}
    shelved = [entry for entry in ideas.get("items", []) if idea_recommendation(entry).id in hidden]
    return {
        "root": str(root),
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "need": need,
        "kinds": list(IDEA_KINDS),
        "repositories": [
            {
                "name": repo.name,
                "technology": repo.technology,
                "branch": repo.branch,
                "age_days": repo.age_days,
                "has_tests": repo.has_tests,
                "has_workflow": repo.has_workflow,
                "has_readme": repo.has_readme,
                "has_remote": bool(repo.remote),
            }
            for repo in repos
        ],
        "tooling": workspace_tooling(root, repos),
        "readmes": readmes,
        "ledger": ledger,
        # The anti-repetition levers: what the band already says, and what the
        # user has already built. A refresh that restates either is wasted.
        "existing_ideas": [{"kind": item.category, "title": item.title} for item in live],
        "recent_done": [
            {"kind": entry.get("kind"), "title": entry.get("title")} for entry in ideas.get("done", [])[-12:]
        ],
        "dismissed": [{"kind": entry["kind"], "title": entry["title"]} for entry in shelved],
    }


def recent_ledger_entries(text: str, entries: int = IDEA_LEDGER_ENTRIES) -> str | None:
    """The newest entries only. The preamble explains the file, not the work, and
    an entry count is a steadier budget than a character count as bodies grow."""
    start = text.find("\n## ")
    body = text[start + 1 :] if start != -1 else text
    pieces = body.split("\n- ")  # pieces[0] is the first day heading
    kept = "\n- ".join(pieces[: entries + 1]).strip()
    return kept[:IDEA_LEDGER_CHARACTERS] or None


IDEA_INSTRUCTIONS = """You are writing the "worth considering" band of Project Pulse, a terminal
dashboard over one developer's ~/Projects workspace.

The rest of the dashboard already reports what local git state implies: dirty trees,
unpushed branches, missing READMEs. Do not duplicate that. Your band exists for the
things no scan can infer.

Write exactly {need} ideas as JSON. Rules:

- Each idea names something that does not exist yet: a new automation, an agent or
  pipeline, a script or command, or a technology worth adopting here.
- Spread across the kinds {kinds}. Do not return two ideas of the same kind while
  another kind is missing.
- Be ambitious and specific to THIS workspace. Refactors, cleanups, "add tests",
  "improve documentation", and "increase coverage" are explicitly out of scope —
  another part of the dashboard covers maintenance.
- Do not restate anything in existing_ideas or recent_done.
- "prompt" is a complete, ready-to-paste instruction for a coding agent that will
  build the idea: what to build, where in the workspace it lands, what it must not
  break, and how to tell it worked. Write it to be pasted with no editing.

Return ONLY this JSON, no prose and no code fence:

{{"ideas": [{{"kind": "automation|agent|script|tech", "title": "short imperative line",
"detail": "one or two sentences on why this is worth doing here",
"prompt": "the full build-it prompt"}}]}}

Here is the workspace:

"""


def extract_json(text: str) -> Any:
    """Tolerate a fenced or prose-wrapped object; reject anything else loudly."""
    stripped = text.strip()
    if stripped.startswith("```"):
        stripped = stripped.split("\n", 1)[-1]
        if stripped.rstrip().endswith("```"):
            stripped = stripped.rstrip()[: -len("```")]
    start, end = stripped.find("{"), stripped.rfind("}")
    if start == -1 or end <= start:
        raise IdeaError("the model returned no JSON object")
    try:
        return json.loads(stripped[start : end + 1])
    except ValueError as error:
        raise IdeaError(f"the model returned unparseable JSON: {error}") from error


def parse_ideas(payload: Any) -> list[dict[str, str]]:
    entries = payload.get("ideas") if isinstance(payload, dict) else payload
    if not isinstance(entries, list) or not entries:
        raise IdeaError("no ideas in the payload")
    parsed: list[dict[str, str]] = []
    for entry in entries:
        if not isinstance(entry, dict):
            raise IdeaError("an idea was not an object")
        candidate = {
            "kind": str(entry.get("kind", "")).strip().lower(),
            "title": str(entry.get("title", "")).strip(),
            "detail": str(entry.get("detail", "")).strip(),
            "prompt": str(entry.get("prompt", "")).strip(),
        }
        if not valid_idea(candidate):
            raise IdeaError(f"an idea was incomplete or had an unknown kind: {candidate['kind'] or '(none)'}")
        parsed.append(candidate)
    return parsed


def idea_key(entry: dict[str, str]) -> tuple[str, str]:
    return entry["kind"], entry["title"].lower()


def enforce_spread(existing: list[dict[str, str]], incoming: list[dict[str, str]]) -> list[dict[str, str]]:
    """Hold back an incoming idea that would crowd its kind while another kind is absent.

    Enforced here rather than trusted to the model, and enforced on what comes
    in rather than on the band: a kept idea is the user's, so a crowded pass
    ends one idea short instead of costing them one. An idea held back early
    is admitted at the end if the rest of the pass filled every kind, since
    repetition is only repetition while something else is missing.
    """
    counts = {kind: 0 for kind in IDEA_KINDS}
    for entry in existing:
        counts[entry["kind"]] += 1
    accepted: list[dict[str, str]] = []
    deferred: list[dict[str, str]] = []
    for entry in incoming:
        if counts[entry["kind"]] >= 2 and any(count == 0 for count in counts.values()):
            deferred.append(entry)
            continue
        counts[entry["kind"]] += 1
        accepted.append(entry)
    if all(counts.values()):
        accepted.extend(deferred)
    return accepted


def merge_ideas(
    existing: list[dict[str, str]], incoming: list[dict[str, str]], free: int
) -> list[dict[str, str]]:
    """Fill `free` slots from incoming; never touch, drop, or reorder an existing idea."""
    seen = {idea_key(entry) for entry in existing}
    fresh: list[dict[str, str]] = []
    for entry in incoming:
        key = idea_key(entry)
        if key in seen:
            continue
        seen.add(key)
        fresh.append(entry)
    return [*existing, *enforce_spread(existing, fresh)[: max(0, free)]]


def free_idea_slots(ideas: dict[str, Any], dismissals: list[dict[str, Any]], limit: int) -> int:
    return max(0, limit - len(visible_ideas(ideas, dismissals)))


def band_full_reason(limit: int) -> str:
    return (
        f"the band is full ({limit}/{limit}); retire one with 'pulse did N', "
        "dismiss one, or raise --ideas"
    )


def generate_ideas(pack: dict[str, Any], model: str = IDEA_MODEL, timeout: int = IDEA_TIMEOUT_SECONDS) -> list[dict[str, str]]:
    """Ask the model for ideas. Any failure raises; the caller keeps what it had."""
    executable = shutil.which("claude")
    if executable is None:
        raise IdeaError("the claude CLI is not on PATH")
    instructions = IDEA_INSTRUCTIONS.format(need=pack["need"], kinds=", ".join(IDEA_KINDS))
    completed = run(
        [executable, "-p", "--model", model, "--output-format", "json", "--restricted"],
        timeout=timeout,
        stdin=instructions + json.dumps(pack, indent=2),
    )
    if completed.returncode != 0:
        detail = (completed.stderr or completed.stdout or "no output").strip().splitlines()
        raise IdeaError(f"claude exited {completed.returncode}: {detail[-1] if detail else 'no output'}")
    try:
        envelope = json.loads(completed.stdout)
    except ValueError as error:
        raise IdeaError(f"claude did not return JSON: {error}") from error
    if isinstance(envelope, dict) and envelope.get("is_error"):
        raise IdeaError(str(envelope.get("result", "claude reported an error")))
    result = envelope.get("result") if isinstance(envelope, dict) else None
    if not isinstance(result, str):
        raise IdeaError("claude returned no result text")
    return parse_ideas(extract_json(result))


def refresh_ideas(
    path: Path, root: Path, repos: list[Repo], dismissals: list[dict[str, Any]], model: str, limit: int = IDEA_LIMIT
) -> dict[str, Any]:
    stored = load_ideas(path)
    need = free_idea_slots(stored, dismissals, limit)
    if need == 0:
        raise IdeaError(band_full_reason(limit))
    pack = build_idea_pack(root, repos, stored, dismissals, need)
    incoming = generate_ideas(pack, model)
    return store_ideas(path, stored, dismissals, incoming, limit, model)


def store_ideas(
    path: Path,
    stored: dict[str, Any],
    dismissals: list[dict[str, Any]],
    incoming: list[dict[str, str]],
    limit: int,
    model: str,
) -> dict[str, Any]:
    """Refill only what the user retired; an untouched idea survives every write.

    A dismissed idea is hidden, not retired: it stays stored so `pulse restore`
    has something to bring back, and its title stays off the incoming list so
    a refresh cannot smuggle it back under the same name.
    """
    done = {entry["id"] for entry in stored.get("done", [])}
    hidden = {entry["id"] for entry in dismissals}
    kept = [entry for entry in stored.get("items", []) if idea_recommendation(entry).id not in done]
    shelved = [entry for entry in kept if idea_recommendation(entry).id in hidden]
    band = [entry for entry in kept if idea_recommendation(entry).id not in hidden]
    shelved_keys = {idea_key(entry) for entry in shelved}
    fresh = [entry for entry in incoming if idea_key(entry) not in shelved_keys]
    updated = {
        **stored,
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "model": model,
        "items": [*merge_ideas(band, fresh, limit - len(band)), *shelved],
    }
    save_ideas(path, updated)
    return updated


@dataclass
class Slot:
    """One numbered line of the live pane. The number is owned for the session."""

    number: int
    item: Recommendation
    resolved_at: datetime | None = None

    @property
    def resolved(self) -> bool:
        return self.resolved_at is not None


class LiveSession:
    """The live pane's numbering: assigned once per item, never reused.

    A slot whose item disappears from a fresh scan is marked resolved and keeps
    its ✓ on screen for RESOLVED_LINGER_SECONDS. The pane then refills to the
    limit with new items on fresh numbers. If a resolved item's condition comes
    back later, it reclaims the number it already owned — a number never means
    two different things inside one session.
    """

    def __init__(self, vibe: str, limit: int):
        self.vibe = vibe
        self.limit = limit
        self.slots: dict[str, Slot] = {}
        self.idea_slots: dict[str, Slot] = {}
        self.next_number = 1

    def refresh(
        self, visible: list[Recommendation], now: datetime, hidden: frozenset[str] = frozenset()
    ) -> list[Slot]:
        fresh = {item.id: item for item in visible}
        for identity, slot in self.slots.items():
            if identity in fresh:
                slot.item = fresh[identity]  # counts in the detail text may have moved
                slot.resolved_at = None
            elif slot.resolved_at is None:
                slot.resolved_at = now

        active = sum(1 for slot in self.slots.values() if not slot.resolved)
        if active < self.limit:
            candidates = [item for item in visible if item.id not in self.slots]
            for item in select_recommendations(candidates, self.vibe, self.limit - active):
                self.slots[item.id] = Slot(self.next_number, item)
                self.next_number += 1

        shown = [
            slot
            for slot in self.slots.values()
            if slot.item.id not in hidden  # dismissed by hand: leave silently, no ✓
            and (
                not slot.resolved
                or (now - slot.resolved_at).total_seconds() < RESOLVED_LINGER_SECONDS
            )
        ]
        return sorted(shown, key=lambda slot: slot.number)


    def refresh_ideas(self, ideas: list[Recommendation]) -> list[Slot]:
        """Ideas draw from the same number counter but never resolve on their own.

        Nothing in a scan can clear an idea, so there is no ✓ state here: an idea
        leaves only when the user retires it with `did` or hides it with `dismiss`.
        """
        fresh = {item.id: item for item in ideas}
        for identity in list(self.idea_slots):
            if identity in fresh:
                self.idea_slots[identity].item = fresh[identity]
            else:
                del self.idea_slots[identity]
        for item in ideas:
            if item.id not in self.idea_slots:
                self.idea_slots[item.id] = Slot(self.next_number, item)
                self.next_number += 1
        return sorted(self.idea_slots.values(), key=lambda slot: slot.number)


class Palette:
    def __init__(self, enabled: bool):
        self.enabled = enabled

    def paint(self, code: str, value: str) -> str:
        return f"\033[{code}m{value}\033[0m" if self.enabled else value

    def bold(self, value: str) -> str:
        return self.paint("1", value)

    def dim(self, value: str) -> str:
        return self.paint("2", value)

    def category(self, value: str) -> str:
        colors = {
            "hygiene": "250;84;185",
            "github": "145;90;240",
            "workflow": "72;124;240",
            "organize": "26;153;123",
            "build": "235;93;72",
            "terminal": "215;145;35",
            "automation": "0;175;185",
            "agent": "210;120;255",
            "script": "150;195;70",
            "tech": "250;205;90",
        }
        label = f"[{value.upper():^10}]"
        return self.paint(f"1;38;2;{colors.get(value, '166;169;178')}", label)

    def muted(self, value: str) -> str:
        return self.paint("38;2;116;120;132", value)

    def fog(self, value: str) -> str:
        return self.paint("38;2;211;210;216", value)

    def signal(self, value: str) -> str:
        return self.paint("38;2;250;84;185", value)

    def ready(self, value: str) -> str:
        return self.paint("1;38;2;26;153;123", value)

    def violet(self, value: str) -> str:
        return self.paint("38;2;155;104;255", value)

    def selection_badge(self, value: str, signal_visible: bool = True) -> str:
        if not self.enabled:
            return f"[{value}]" if signal_visible else f" {value} "
        background = "250;84;185" if signal_visible else "211;210;216"
        return self.paint(f"1;38;2;32;33;38;48;2;{background}", f" {value} ")

    def gradient(
        self,
        value: str,
        start: tuple[int, int, int] = (255, 76, 176),
        end: tuple[int, int, int] = (139, 99, 255),
    ) -> str:
        if not self.enabled or not value:
            return value
        last = max(1, len(value) - 1)
        pieces: list[str] = []
        for index, character in enumerate(value):
            if character == " ":
                pieces.append(character)
                continue
            ratio = index / last
            red = round(start[0] + (end[0] - start[0]) * ratio)
            green = round(start[1] + (end[1] - start[1]) * ratio)
            blue = round(start[2] + (end[2] - start[2]) * ratio)
            pieces.append(f"\033[38;2;{red};{green};{blue}m{character}")
        pieces.append("\033[0m")
        return "".join(pieces)

    def plate(self, value: str, width: int) -> str:
        value = value[:width].rstrip()
        if not self.enabled:
            return value
        # ANSI background cells are opaque, even when Terminal's own background
        # is translucent. Keep this secondary band on the terminal's default
        # background so it does not turn into a bright slab over blur.
        return self.paint("1;38;2;166;169;178", value)


def dashboard_width() -> int:
    columns = shutil.get_terminal_size(fallback=(104, 36)).columns
    return max(DASHBOARD_MIN_WIDTH, min(columns, DASHBOARD_MAX_WIDTH))


def dashboard_height() -> int:
    return shutil.get_terminal_size(fallback=(104, 36)).lines


def terminal_columns() -> int:
    """The real column count, unclamped, for deciding whether the pane fits at all."""
    return shutil.get_terminal_size(fallback=(104, 36)).columns


def viewport_below_floor() -> bool:
    return terminal_columns() < DASHBOARD_MIN_WIDTH or dashboard_height() < DASHBOARD_MIN_HEIGHT


def print_floor_notice(palette: Palette) -> None:
    """What the live pane shows when even its smallest layout does not fit.

    Every line clips to the real width, so nothing wraps and nothing scrolls;
    the dashboard comes back on the next resize.
    """
    width = max(1, min(terminal_columns(), DASHBOARD_MAX_WIDTH))
    for row in wordmark_rows(1):
        shown = clip_text(row, width)
        print(" " * max(0, (width - len(shown)) // 2) + palette.gradient(shown))
    print()
    notice = clip_text(f"MAKE THE WINDOW {DASHBOARD_MIN_WIDTH}x{DASHBOARD_MIN_HEIGHT} OR LARGER", width)
    print(" " * max(0, (width - len(notice)) // 2) + palette.muted(notice))


def clip_text(value: str, width: int) -> str:
    if width <= 0:
        return ""
    if len(value) <= width:
        return value
    if width == 1:
        return "…"
    return value[: width - 1].rstrip() + "…"


def spread_line(left: str, right: str, width: int, fill: str = " ") -> str:
    if not right:
        return clip_text(left, width)
    if len(left) + len(right) + 1 > width:
        left = clip_text(left, max(1, width - len(right) - 1))
    gap = max(1, width - len(left) - len(right))
    return clip_text(left + fill * gap + right, width)


def rule_line(left: str, right: str, width: int) -> str:
    return spread_line(left, right, width, "─")


def wordmark_rows(horizontal_scale: int = 2) -> list[str]:
    letters = "PULSE"
    logical_height = len(next(iter(WORDMARK_GLYPHS.values()))) + max(WORDMARK_OFFSETS)
    logical_width = len(letters) * 5 * horizontal_scale + (len(letters) - 1) * horizontal_scale
    pixels = [[False for _column in range(logical_width)] for _row in range(logical_height)]
    column = 0
    for letter, offset in zip(letters, WORDMARK_OFFSETS):
        glyph = WORDMARK_GLYPHS[letter]
        for glyph_row, pattern in enumerate(glyph):
            for glyph_column, filled in enumerate(pattern):
                if filled == "1":
                    start = column + glyph_column * horizontal_scale
                    for scaled_column in range(start, start + horizontal_scale):
                        pixels[glyph_row + offset][scaled_column] = True
        column += 6 * horizontal_scale

    rows: list[str] = []
    for upper_row in range(0, logical_height, 2):
        lower_row = upper_row + 1
        characters: list[str] = []
        for pixel_column in range(logical_width):
            upper = pixels[upper_row][pixel_column]
            lower = lower_row < logical_height and pixels[lower_row][pixel_column]
            characters.append("█" if upper and lower else "▀" if upper else "▄" if lower else " ")
        rows.append("".join(characters))
    return rows


def wordmark_scale(width: int) -> int:
    """Keep the masthead compact until the pane is genuinely wide."""
    return 2 if width >= 120 else 1


def print_masthead(
    palette: Palette, width: int, now: datetime, live: bool, label: str = "RECOMMENDATION INDEX"
) -> None:
    state = "LIVE SIGNAL" if live else "STATIC SCAN"
    stamp = now.strftime("%a %b %-d / %-I:%M %p")
    left = f"PROJECT PULSE // {label}"
    right = f"{stamp} / {state}"
    plain = spread_line(left, right, width)
    state_at = plain.rfind(state)
    if state_at >= 0 and live:
        print(palette.muted(plain[:state_at]) + palette.signal(plain[state_at:]))
    else:
        print(palette.muted(plain))
    scale = wordmark_scale(width)
    for row in wordmark_rows(scale):
        padding = " " * max(0, (width - len(row)) // 2)
        print(padding + palette.gradient(row))


def pack_segments(segments: list[str], width: int) -> list[str]:
    lines: list[str] = []
    current = ""
    for segment in segments:
        candidate = segment if not current else f"{current}  │  {segment}"
        if current and len(candidate) > width:
            lines.append(current)
            current = segment
        else:
            current = candidate
    if current:
        lines.append(current)
    return lines


def github_status(
    github: GithubSnapshot,
    github_fetched_at: datetime | None = None,
    github_is_fresh: bool = True,
) -> str:
    if not github.available:
        return "GITHUB OFFLINE"
    if not github_is_fresh and github_fetched_at is not None:
        stamp = github_fetched_at.astimezone().strftime("%-I:%M %p")
        return f"GITHUB @{github.user} / AS OF {stamp}"
    return f"GITHUB @{github.user}"


def instrument_segments(
    repos: list[Repo],
    github: GithubSnapshot,
    github_fetched_at: datetime | None = None,
    github_is_fresh: bool = True,
) -> list[str]:
    dirty = sum(not repo.clean for repo in repos)
    branches = sum(repo.branch not in MAIN_BRANCHES for repo in repos)
    no_remote = sum(not repo.remote for repo in repos)
    return [
        f"{len(repos):02d} REPOSITORIES",
        f"{dirty:02d} OPEN LOOPS",
        f"{branches:02d} TOPIC BRANCHES",
        f"{no_remote:02d} LOCAL ONLY",
        github_status(github, github_fetched_at, github_is_fresh),
    ]


def print_instrument_band(
    root: Path,
    repos: list[Repo],
    github: GithubSnapshot,
    palette: Palette,
    width: int,
    github_fetched_at: datetime | None = None,
    github_is_fresh: bool = True,
) -> None:
    workspace = clip_text(str(root), max(18, width - 28))
    print(palette.plate(spread_line(f"  WORKSPACE / {workspace}", "SCAN 01 / LOCAL INDEX  ", width), width))
    segments = instrument_segments(repos, github, github_fetched_at, github_is_fresh)
    for line in pack_segments(segments, width - 4):
        print(palette.plate(f"  {line}", width))


