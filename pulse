def idea_stamp(generated_at: str | None) -> str:
    if not generated_at:
        return "REFRESH ON REQUEST"
    try:
        when = datetime.fromisoformat(generated_at).astimezone()
    except (TypeError, ValueError):
        return "REFRESH ON REQUEST"
    return f"WRITTEN {when.strftime('%b %d').upper().replace(' 0', ' ')}"


